---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';

interface Props {
  /** Título de la página (sin el nombre del sitio). */
  titulo?: string;
  /** Descripción para buscadores. Si falta, se usa la del sitio. */
  descripcion?: string;
  /** true para pedir a los buscadores que no indexen (p. ej. 404). */
  noindex?: boolean;
  /** true en las páginas que maquetan su propio ancho (la portada). */
  anchoCompleto?: boolean;
}

const { titulo, descripcion = SITE.descripcion, noindex = false, anchoCompleto = false } = Astro.props;

const tituloCompleto = titulo ? `${titulo} · ${SITE.titulo}` : SITE.titulo;
// Solo hay URL canónica si `site` está configurado en astro.config.mjs.
const canonica = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---

<!doctype html>
<html lang={SITE.idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <meta name="author" content={SITE.autor} />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonica && <link rel="canonical" href={canonica} />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:locale" content="es_ES" />
    {canonica && <meta property="og:url" content={canonica} />}

    <!-- El avatar, recortado a la cara: es lo que mejor se lee a 16-18 px en la pestaña. -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c1116" media="(prefers-color-scheme: dark)" />

    <!-- Las dos fuentes que se ven desde el primer pintado. El resto se piden solo si hacen falta. -->
    <link rel="preload" href="/fuentes/ibm-plex-sans-var-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fuentes/ibm-plex-mono-400-latin.woff2" as="font" type="font/woff2" crossorigin />

    <!--
      Sin preferencia guardada manda el tema del sistema (color-scheme: light dark).
      Si el visitante eligió uno, se aplica antes de pintar para evitar el parpadeo.
    -->
    <script is:inline>
      try {
        const tema = localStorage.getItem('tema');
        if (tema === 'light' || tema === 'dark') document.documentElement.dataset.theme = tema;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido" tabindex="-1" class:list={{ ancho: anchoCompleto }}>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  /* La portada maqueta sus propias bandas, así que el <main> no añade relleno lateral. */
  main.ancho {
    max-width: none;
    padding: 0;
  }
</style>
