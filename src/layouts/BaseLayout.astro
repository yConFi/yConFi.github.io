---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BuscadorGlobal from '../components/BuscadorGlobal.astro';
import { SITE } from '../data/site';
import type { Miga } from '../components/Migas.astro';
import { IDIOMA_POR_DEFECTO, LANG, OG_LOCALE, rutaEquivalente, textos, type Idioma } from '../i18n';
import { IDIOMAS } from '../i18n/idiomas';
import { jsonLd, serializar, type TipoSeo } from '../lib/seo';

interface Props {
  /** Idioma de la página. Lo pasa la ruta, nunca se adivina. */
  idioma: Idioma;
  /** Título de la página (sin el nombre del sitio). */
  titulo?: string;
  /** Descripción para buscadores. Si falta, se usa la del sitio. */
  descripcion?: string;
  /** true para pedir a los buscadores que no indexen (p. ej. 404). */
  noindex?: boolean;
  /** true en las páginas que maquetan su propio ancho (la portada). */
  anchoCompleto?: boolean;
  /**
   * La misma página en cada idioma, para `hreflang` y para el selector.
   *
   * Las secciones fijas no hace falta que lo pasen: se saca de la tabla de rutas.
   * Las páginas con parámetro (un walkthrough, una técnica, un proyecto) sí, porque
   * el slug puede cambiar de idioma y solo ellas saben cuál es el suyo.
   */
  equivalentes?: Partial<Record<Idioma, string>>;
  /** Tipo de página para los datos estructurados. Por defecto, una página web. */
  tipoSeo?: TipoSeo;
  /** Fecha real del contenido (frontmatter), si la tiene. */
  fecha?: Date;
  /** Última actualización real, si la hubo. */
  actualizado?: Date;
  /** Migas de pan, para BreadcrumbList (las mismas que pinta <Migas>). */
  migas?: Miga[];
  /** Repositorio público (proyectos). */
  repositorio?: string;
  palabrasClave?: string[];
  /** true si el CUERPO está en castellano aunque la página sea de otro idioma. */
  contenidoEnCastellano?: boolean;
}

const {
  idioma,
  titulo,
  descripcion,
  noindex = false,
  anchoCompleto = false,
  equivalentes,
  tipoSeo = 'pagina',
  fecha,
  actualizado,
  migas,
  repositorio,
  palabrasClave,
  contenidoEnCastellano = false,
} = Astro.props;

const t = textos(idioma);
const descripcionFinal = descripcion ?? t.general.descripcionSitio;
const tituloCompleto = titulo ? `${titulo} · ${SITE.titulo}` : SITE.titulo;

// Solo hay URL canónica si `site` está configurado en astro.config.mjs.
const absoluta = (ruta: string) => (Astro.site ? new URL(ruta, Astro.site).href : undefined);
const canonica = absoluta(Astro.url.pathname);

// Enlaces entre idiomas: lo que pase la página y, si no, la tabla de rutas.
const alternativas = new Map<Idioma, string>();
for (const otro of IDIOMAS) {
  const ruta = equivalentes?.[otro] ?? rutaEquivalente(Astro.url.pathname, otro);
  if (ruta) alternativas.set(otro, ruta);
}

// x-default: la versión en castellano, que es la original.
const porDefecto = alternativas.get(IDIOMA_POR_DEFECTO);

// Vista previa al compartir: imagen generada en local (public/og/), 1200×630.
const imagen = absoluta(`/og/yconfi-${idioma}.png`);
const esArticulo = tipoSeo === 'articulo' || tipoSeo === 'proyecto';

const datosEstructurados =
  Astro.site && canonica && !noindex
    ? jsonLd({
        tipo: tipoSeo,
        idioma,
        url: canonica,
        sitio: new URL('/', Astro.site).href,
        titulo: titulo ?? SITE.titulo,
        descripcion: descripcionFinal,
        idiomaContenido: contenidoEnCastellano ? IDIOMA_POR_DEFECTO : idioma,
        fecha,
        actualizado,
        repositorio,
        palabrasClave,
        migas: migas?.map((m) => ({ nombre: m.texto, url: absoluta(m.href ?? Astro.url.pathname)! })),
      })
    : undefined;
---

<!doctype html>
<html lang={LANG[idioma]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcionFinal} />
    <meta name="author" content={SITE.autor} />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonica && <link rel="canonical" href={canonica} />}

    {/* Una página por idioma: cada una se declara a sí misma y a su pareja. */}
    {
      !noindex &&
        [...alternativas].map(([otro, ruta]) => {
          const href = absoluta(ruta);
          return href && <link rel="alternate" hreflang={LANG[otro]} href={href} />;
        })
    }
    {!noindex && porDefecto && absoluta(porDefecto) && <link rel="alternate" hreflang="x-default" href={absoluta(porDefecto)} />}

    <meta property="og:site_name" content={SITE.titulo} />
    <meta property="og:type" content={esArticulo ? 'article' : 'website'} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcionFinal} />
    <meta property="og:locale" content={OG_LOCALE[idioma]} />
    {canonica && <meta property="og:url" content={canonica} />}
    {imagen && <meta property="og:image" content={imagen} />}
    {imagen && <meta property="og:image:width" content="1200" />}
    {imagen && <meta property="og:image:height" content="630" />}
    {imagen && <meta property="og:image:alt" content={t.general.ogAlt} />}
    {esArticulo && fecha && <meta property="article:published_time" content={fecha.toISOString().slice(0, 10)} />}
    <meta name="twitter:card" content="summary_large_image" />
    {datosEstructurados && <script type="application/ld+json" set:html={serializar(datosEstructurados)} />}

    <!-- El avatar, recortado a la cara: es lo que mejor se lee a 16-18 px en la pestaña. -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#181d21" media="(prefers-color-scheme: dark)" />

    <!-- Las dos fuentes que se ven desde el primer pintado. El resto se piden solo si hacen falta. -->
    <link rel="preload" href="/fuentes/ibm-plex-sans-var-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fuentes/ibm-plex-mono-400-latin.woff2" as="font" type="font/woff2" crossorigin />

    <!--
      Sin preferencia guardada manda el tema del sistema (color-scheme: light dark).
      Si el visitante eligió uno, se aplica antes de pintar para evitar el parpadeo.
    -->
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        const tema = localStorage.getItem('tema');
        if (tema === 'light' || tema === 'dark') document.documentElement.dataset.theme = tema;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">{t.general.saltarContenido}</a>
    <Header idioma={idioma} alternativas={alternativas} />
    <main id="contenido" tabindex="-1" class:list={{ ancho: anchoCompleto }}>
      <slot />
    </main>
    <Footer idioma={idioma} />
    <BuscadorGlobal idioma={idioma} />
  </body>
</html>

<style>
  /* La portada maqueta sus propias bandas, así que el <main> no añade relleno lateral. */
  main.ancho {
    max-width: none;
    padding: 0;
  }
</style>
