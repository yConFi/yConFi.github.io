---
// Botón de "me ha servido" para toda la web, con contador real. Vive en la
// barra de arriba (Header), junto al idioma y el tema, así que sale en todas
// las páginas.
//
// En la barra solo se ve un botón compacto con el pulgar y el número. Al
// pulsarlo se despliega un panel con la explicación de privacidad y el botón
// que vota de verdad: así el aviso de que es anónimo sigue a la vista (también
// en móvil) y nadie vota por un clic accidental.
//
// El número lo sirve el Worker de `worker/` (un Durable Object, ver su README).
// Aquí no hay ninguna cifra escrita a mano: el bloque empieza oculto y solo
// aparece cuando el endpoint ha contestado. Si el endpoint no está configurado
// o no responde, no se muestra nada. Mejor sin botón que con un número falso.
//
// Que una misma persona no vote dos veces se resuelve en su navegador con
// localStorage: aguanta recargar, cerrar y volver meses después. No aguanta
// incógnito, borrar los datos del sitio ni cambiar de dispositivo, y se acepta:
// la alternativa es identificar a cada visitante.
import { CONTADOR_UTIL } from '../data/site';
import { textos, type Idioma } from '../i18n';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const t = textos(idioma);

// Un valor distinto "reabre" el voto a todo el mundo, por si hay que reiniciar.
// El contador es el MISMO para los dos idiomas: cuenta personas, no visitas a
// una versión de la página.
const CLAVE = 'util-votado-v1';
---

{
  CONTADOR_UTIL.endpoint && (
    <div
      class="util"
      data-util
      data-endpoint={CONTADOR_UTIL.endpoint}
      data-clave={CLAVE}
      data-txt-nadie={t.util.nadie}
      data-txt-una={t.util.una}
      data-txt-varias={t.util.varias}
      data-txt-muchos={t.util.falloMuchos}
      data-txt-fallo={t.util.falloGenerico}
      hidden
    >
      <button
        type="button"
        class="abrir"
        aria-expanded="false"
        aria-controls="panel-util"
        data-util-abrir
      >
        <svg class="icono si" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M7 11v9H4a1 1 0 0 1-1-1v-7a1 1 0 0 1 1-1h3Z" />
          <path d="M7 11l4.2-7.5a1.6 1.6 0 0 1 2.9 1.2L13.2 9h5.2a1.9 1.9 0 0 1 1.9 2.3l-1.2 6A2 2 0 0 1 17.1 19H7" />
        </svg>
        <svg class="icono ya" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m5 13 4 4L19 7" />
        </svg>
        <span class="texto-barra">{t.util.titulo}</span>
        <span class="numero-barra" data-util-numero-barra />
      </button>

      <div class="panel" id="panel-util" data-util-panel hidden>
        <p class="titulo">{t.util.titulo}</p>
        <p class="texto">{t.util.texto}</p>

        <button type="button" class="boton boton-principal votar" data-util-boton>
          <svg class="icono si" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 11v9H4a1 1 0 0 1-1-1v-7a1 1 0 0 1 1-1h3Z" />
            <path d="M7 11l4.2-7.5a1.6 1.6 0 0 1 2.9 1.2L13.2 9h5.2a1.9 1.9 0 0 1 1.9 2.3l-1.2 6A2 2 0 0 1 17.1 19H7" />
          </svg>
          <svg class="icono ya" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m5 13 4 4L19 7" />
          </svg>
          <span class="si">{t.util.boton}</span>
          <span class="ya">{t.util.gracias}</span>
        </button>

        <p class="cuenta" aria-live="polite">
          <strong class="numero" data-util-numero />
          <span data-util-frase />
        </p>

        <p class="fallo" role="alert" data-util-fallo hidden />
      </div>
    </div>
  )
}

<script>
  const bloque = document.querySelector<HTMLElement>('[data-util]');
  const abrir = bloque?.querySelector<HTMLButtonElement>('[data-util-abrir]');
  const panel = bloque?.querySelector<HTMLElement>('[data-util-panel]');
  const numeroBarra = bloque?.querySelector<HTMLElement>('[data-util-numero-barra]');
  const boton = bloque?.querySelector<HTMLButtonElement>('[data-util-boton]');
  const numero = bloque?.querySelector<HTMLElement>('[data-util-numero]');
  const frase = bloque?.querySelector<HTMLElement>('[data-util-frase]');
  const fallo = bloque?.querySelector<HTMLElement>('[data-util-fallo]');

  if (bloque && abrir && panel && numeroBarra && boton && numero && frase && fallo) {
    const endpoint = bloque.dataset.endpoint ?? '';
    const clave = bloque.dataset.clave ?? 'util-votado-v1';
    const txt = {
      nadie: bloque.dataset.txtNadie ?? '',
      una: bloque.dataset.txtUna ?? '',
      varias: bloque.dataset.txtVarias ?? '',
      muchos: bloque.dataset.txtMuchos ?? '',
      fallo: bloque.dataset.txtFallo ?? '',
    };

    // ---------- Abrir y cerrar el panel ----------
    const mostrarPanel = (visible: boolean) => {
      panel.hidden = !visible;
      abrir.setAttribute('aria-expanded', String(visible));
    };

    abrir.addEventListener('click', () => mostrarPanel(panel.hidden));

    // Se cierra con Escape (devolviendo el foco al botón) y al pulsar fuera.
    document.addEventListener('keydown', (evento) => {
      if (evento.key === 'Escape' && !panel.hidden) {
        mostrarPanel(false);
        abrir.focus();
      }
    });

    document.addEventListener('click', (evento) => {
      if (!panel.hidden && !bloque.contains(evento.target as Node)) mostrarPanel(false);
    });

    // ---------- Contador ----------
    // Si el navegador no deja leer el almacenamiento (incógnito en algunos
    // casos, datos bloqueados), se da por no votado: el botón sigue usable.
    const yaVotado = () => {
      try {
        return localStorage.getItem(clave) === '1';
      } catch {
        return false;
      }
    };

    const pintar = (total: number, votado: boolean) => {
      numero.textContent = String(total);
      numeroBarra.textContent = String(total);
      frase.textContent = total === 0 ? txt.nadie : total === 1 ? txt.una : txt.varias;

      bloque.classList.toggle('votado', votado);
      boton.disabled = votado;
    };

    const leerTotal = async (respuesta: Response) => {
      const datos: unknown = await respuesta.json();
      const total = (datos as { total?: unknown }).total;
      if (typeof total !== 'number' || !Number.isFinite(total)) throw new Error('respuesta inesperada');
      return total;
    };

    // Arranque: se pide el total y solo entonces se enseña el botón. Si falla,
    // se queda oculto y la página no muestra ningún contador.
    (async () => {
      try {
        const respuesta = await fetch(endpoint, { method: 'GET' });
        if (!respuesta.ok) throw new Error(String(respuesta.status));
        pintar(await leerTotal(respuesta), yaVotado());
        bloque.hidden = false;
      } catch {
        /* sin contador no hay botón: se deja oculto */
      }
    })();

    boton.addEventListener('click', async () => {
      // Se desactiva ya para que un doble clic no mande dos peticiones.
      boton.disabled = true;
      fallo.hidden = true;

      try {
        const respuesta = await fetch(endpoint, { method: 'POST' });

        if (respuesta.status === 429) {
          // Tope por minuto del Worker: el voto no se ha guardado.
          throw new Error('demasiados');
        }
        if (!respuesta.ok) throw new Error(String(respuesta.status));

        const total = await leerTotal(respuesta);
        try {
          localStorage.setItem(clave, '1');
        } catch {
          /* sin almacenamiento el voto cuenta, pero no se recuerda */
        }
        pintar(total, true);
      } catch (error) {
        boton.disabled = false;
        fallo.textContent =
          error instanceof Error && error.message === 'demasiados' ? txt.muchos : txt.fallo;
        fallo.hidden = false;
      }
    });
  }
</script>

<style>
  .util {
    position: relative;
    flex-shrink: 0;
  }

  .util[hidden] {
    display: none;
  }

  /* ---------- Botón de la barra ---------- */
  /* Mismo alto, fondo y borde que el selector de idioma y el botón de tema,
     para que los tres se lean como un grupo. */
  .abrir {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 2.75rem;
    padding: 0 0.7rem;
    background: var(--bg-elev);
    color: var(--texto-suave);
    border: 1px solid var(--borde);
    border-radius: var(--radio);
    font-family: var(--fuente-mono);
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
  }

  .abrir:hover,
  .abrir[aria-expanded='true'] {
    border-color: var(--acento);
    color: var(--texto);
  }

  /* En pantallas estrechas solo icono y número; el texto sigue ahí para los
     lectores de pantalla. */
  .texto-barra {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (min-width: 75rem) {
    .texto-barra {
      position: static;
      width: auto;
      height: auto;
      margin: 0;
      overflow: visible;
      clip: auto;
      font-family: var(--fuente-texto);
      font-weight: 500;
    }
  }

  .numero-barra {
    color: var(--acento-texto);
  }

  .icono {
    width: 1.05rem;
    height: 1.05rem;
    flex-shrink: 0;
  }

  /* ---------- Panel desplegable ---------- */
  .panel {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    z-index: 60;
    width: min(21rem, calc(100vw - 2 * var(--gutter)));
    padding: 1.1rem 1.2rem;
    background: var(--bg-elev);
    border: 1px solid var(--borde);
    border-radius: var(--radio);
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.25);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.7rem;
  }

  .panel[hidden] {
    display: none;
  }

  /* En móvil el botón no está pegado al borde derecho (le siguen el idioma y
     el tema), así que el panel se ancla a la cabecera entera: ocupa el ancho
     útil justo debajo de la fila de botones y nunca se sale de la pantalla.
     La cabecera es sticky, y por eso hace de referencia para el absolute. */
  @media (max-width: 40rem) {
    .util {
      position: static;
    }

    .panel {
      top: calc(0.7rem + 2.75rem + 0.5rem);
      left: var(--gutter);
      right: var(--gutter);
      width: auto;
    }
  }

  .titulo {
    margin: 0;
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--texto);
  }

  .texto {
    margin: 0;
    font-size: 0.9rem;
    color: var(--texto-suave);
  }

  .votar {
    /* Altura fija para que no cambie al pasar a "¡Gracias!". */
    min-height: 2.75rem;
  }

  .cuenta {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    font-size: 0.875rem;
    color: var(--texto-suave);
  }

  .numero {
    font-family: var(--fuente-mono);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--acento-texto);
  }

  .fallo {
    margin: 0;
    font-size: 0.85rem;
    color: var(--peligro);
  }

  .fallo[hidden] {
    display: none;
  }

  /* ---------- Estado "ya votado" ---------- */
  /* Qué icono y qué texto se ven lo decide el CSS a partir de la clase del
     bloque, igual que en el botón de tema, para que no haya parpadeo. */
  .ya {
    display: none;
  }

  .votado .si {
    display: none;
  }

  .votado .ya {
    display: inline-flex;
  }

  .votado span.ya {
    display: inline;
  }

  .votado .votar[disabled] {
    /* Ya cumplió su función: deja de pedir el clic, pero se queda legible. */
    border-color: var(--borde);
    background: var(--bg-elev-2);
    color: var(--texto-suave);
    cursor: default;
    filter: none;
  }
</style>
