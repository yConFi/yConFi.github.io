---
import type { Proyecto } from '../lib/coleccion';

interface Props {
  proyecto: Proyecto;
  nivel?: 'h2' | 'h3';
}

const { proyecto: p, nivel: Titulo = 'h2' } = Astro.props;
// "En producción" y "Terminado" son estados buenos; el resto se quedan en gris.
const activo = p.data.estado === 'En producción';
---

<article class="tarjeta">
  <div class="encabezado">
    <Titulo class="titulo">
      <a href={`/proyectos/${p.id}/`}>{p.data.titulo}</a>
      {p.data.borrador && <span class="borrador">borrador</span>}
    </Titulo>
    <p class:list={['estado', { activo }]}>
      <span class="punto" aria-hidden="true"></span>{p.data.estado}
    </p>
  </div>

  <p class="resumen">{p.data.resumen}</p>

  <ul class="tecnologias" aria-label="Tecnologías">
    {p.data.tecnologias.map((t) => <li class="etiqueta">{t}</li>)}
  </ul>
</article>

<style>
  .tarjeta {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .encabezado {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem 0.75rem;
  }

  .titulo {
    margin: 0;
    font-size: 1.25rem;
    flex-grow: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .titulo a {
    color: var(--texto);
    text-decoration: none;
  }

  .titulo a:hover {
    color: var(--acento-texto);
    text-decoration: underline;
  }

  .borrador {
    font-family: var(--fuente-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.1rem 0.45rem;
    border-radius: var(--radio-pill);
    border: 1px solid var(--peligro);
    color: var(--peligro);
  }

  .estado {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
    font-family: var(--fuente-mono);
    font-size: 0.78rem;
    color: var(--texto-suave);
  }

  .punto {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: currentColor;
  }

  .estado.activo {
    color: var(--acento-texto);
  }

  .resumen {
    margin: 0;
    font-size: 0.97rem;
    color: var(--texto-suave);
  }

  .tecnologias {
    list-style: none;
    margin: auto 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
</style>
