---
// Esquema visual del camino seguido en la máquina, de la máquina atacante al objetivo.
// Se adapta al tema claro/oscuro y en móvil se apila en vertical.
// Uso en MDX:
//   <Ruta
//     titulo="Camino hasta root"
//     pasos={[
//       { titulo: 'nmap', detalle: '23/tcp abierto' },
//       { titulo: 'root', detalle: 'Acceso completo', meta: true },
//     ]}
//   />
interface Paso {
  titulo: string;
  detalle: string;
  /** Paso final (p. ej. root): se resalta. */
  meta?: boolean;
}

interface Props {
  titulo: string;
  pasos: Paso[];
}

const { titulo, pasos } = Astro.props;
---

<figure class="ruta">
  <figcaption>{titulo}</figcaption>
  <ol>
    {
      pasos.map((p, i) => (
        <li class:list={['paso', { meta: p.meta }]}>
          <span class="numero" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <strong class="titulo">{p.titulo}</strong>
          <span class="detalle">{p.detalle}</span>
        </li>
      ))
    }
  </ol>
</figure>

<style>
  .ruta {
    margin: 1.75rem 0;
    padding: 1.1rem 1.2rem;
    border: 1px solid var(--borde);
    border-radius: var(--radio-lg);
    background: var(--bg-elev);
  }

  figcaption {
    font-family: var(--fuente-mono);
    font-size: 0.7rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--texto-suave);
    margin-bottom: 0.9rem;
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.75rem;
  }

  .paso {
    position: relative;
    display: grid;
    gap: 0.1rem;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--borde);
    border-radius: var(--radio);
    background: var(--bg);
  }

  .paso.meta {
    border-color: var(--acento);
    background: var(--acento-bg);
  }

  /* Flecha hacia el siguiente paso (abajo en móvil, a la derecha en escritorio). */
  .paso:not(:last-child)::after {
    content: '↓';
    position: absolute;
    left: 50%;
    bottom: -1.55rem;
    transform: translateX(-50%);
    color: var(--texto-tenue);
    font-size: 1.05rem;
    line-height: 1;
  }

  .numero {
    font-family: var(--fuente-mono);
    font-size: 0.65rem;
    color: var(--texto-tenue);
  }

  .titulo {
    font-family: var(--fuente-mono);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--tok-opcion);
    overflow-wrap: anywhere;
  }

  .meta .titulo {
    color: var(--acento-texto);
  }

  .detalle {
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--texto-suave);
  }

  @media (min-width: 48rem) {
    ol {
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }

    .paso:not(:last-child)::after {
      content: '→';
      left: auto;
      right: -1.2rem;
      bottom: auto;
      top: 50%;
      transform: translateY(-50%);
    }
  }
</style>
