---
import { ENLACES, SITE } from '../data/site';

const anio = new Date().getFullYear();
---

<footer class="pie">
  <div class="contenedor">
    <p>© {anio} {SITE.autor}</p>
    <ul aria-label="Redes">
      <li><a href={ENLACES.github} rel="me noopener">GitHub</a></li>
      <li><a href={ENLACES.linkedin} rel="me noopener">LinkedIn</a></li>
    </ul>
  </div>
</footer>

<style>
  .pie {
    border-top: 1px solid var(--borde);
    background: var(--bg-elev);
    font-family: var(--fuente-mono);
    font-size: 0.9rem;
    color: var(--texto-suave);
  }

  .contenedor {
    max-width: var(--ancho-max);
    margin-inline: auto;
    padding: 1rem var(--gutter);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem 1.5rem;
  }

  p {
    margin: 0;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 1.25rem;
  }

  a {
    display: inline-block;
    padding: 0.4rem 0;
  }
</style>
