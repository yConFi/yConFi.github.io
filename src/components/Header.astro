---
import { esSeccionActiva, NAVEGACION } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';

const ruta = Astro.url.pathname;
---

<header class="cabecera">
  <div class="contenedor">
    <a href="/" class="logo" aria-label="Inicio">
      <span class="prompt-logo" aria-hidden="true">~/</span>yconfi<span class="cursor" aria-hidden="true">_</span>
    </a>

    <nav aria-label="Principal">
      <ul>
        {
          NAVEGACION.map((enlace) => (
            <li>
              <a href={enlace.href} aria-current={esSeccionActiva(enlace, ruta) ? 'page' : undefined}>
                {enlace.texto}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ThemeToggle />
  </div>
</header>

<style>
  .cabecera {
    border-bottom: 1px solid var(--borde);
    background: var(--bg);
  }

  .contenedor {
    max-width: var(--ancho-max);
    margin-inline: auto;
    padding: 0.7rem var(--gutter);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
  }

  .logo {
    font-family: var(--fuente-mono);
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    color: var(--texto);
    text-decoration: none;
    margin-right: auto;
  }

  .prompt-logo,
  .cursor {
    color: var(--acento);
  }

  .cursor {
    animation: parpadeo 1.1s steps(1) infinite;
  }

  @keyframes parpadeo {
    50% {
      opacity: 0;
    }
  }

  nav {
    order: 3;
    width: 100%;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }

  nav a {
    display: inline-block;
    padding: 0.5rem 0.7rem;
    border-radius: var(--radio-sm);
    font-family: var(--fuente-mono);
    font-size: 0.875rem;
    color: var(--texto-suave);
    text-decoration: none;
  }

  nav a:hover {
    background: var(--bg-elev);
    color: var(--texto);
  }

  /* La sección en la que estás se marca con el verde relleno, no solo con color. */
  nav a[aria-current='page'] {
    background: var(--acento);
    color: var(--acento-sobre);
    font-weight: 600;
  }

  nav a[aria-current='page']:hover {
    background: var(--acento);
    color: var(--acento-sobre);
  }

  @media (min-width: 52rem) {
    nav {
      order: 0;
      width: auto;
    }
  }
</style>
