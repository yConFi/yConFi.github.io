---
import ThemeToggle from './ThemeToggle.astro';
import SelectorIdioma from './SelectorIdioma.astro';
import { esSeccionActiva, navegacion, ruta as rutaDe, textos, type Idioma } from '../i18n';

interface Props {
  idioma: Idioma;
  /** La misma página en cada idioma, para el selector. La calcula BaseLayout. */
  alternativas: Map<Idioma, string>;
}

const { idioma, alternativas } = Astro.props;
const t = textos(idioma);
const enlaces = navegacion(idioma, t.nav);
const ruta = Astro.url.pathname;
---

<header class="cabecera" id="cabecera">
  <div class="contenedor">
    <a href={rutaDe('inicio', idioma)} class="logo" aria-label={t.general.irAlInicio}>
      <span class="prompt-logo" aria-hidden="true">~/</span>yconfi<span class="cursor" aria-hidden="true">_</span>
    </a>

    <nav aria-label={t.general.navPrincipal}>
      <ul>
        {
          enlaces.map((enlace) => (
            <li>
              <a href={enlace.href} aria-current={esSeccionActiva(enlace, ruta) ? 'page' : undefined}>
                {enlace.texto}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="controles">
      <SelectorIdioma idioma={idioma} alternativas={alternativas} />
      <ThemeToggle idioma={idioma} />
    </div>
  </div>
</header>

<style>
  /* La barra acompaña al scroll. Al bajar se esconde para dejar sitio al texto;
     al subir reaparece, así no hay que volver al principio de la página. */
  .cabecera {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--borde);
    background: var(--bg);
    transition: transform 0.25s ease;
  }

  .cabecera.oculta {
    transform: translateY(-100%);
  }

  @media (prefers-reduced-motion: reduce) {
    .cabecera {
      transition: none;
    }
  }

  .contenedor {
    max-width: var(--ancho-max);
    margin-inline: auto;
    padding: 0.7rem var(--gutter);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
  }

  .logo {
    font-family: var(--fuente-mono);
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    color: var(--texto);
    text-decoration: none;
    margin-right: auto;
  }

  .prompt-logo,
  .cursor {
    color: var(--acento);
  }

  .cursor {
    animation: parpadeo 1.1s steps(1) infinite;
  }

  @keyframes parpadeo {
    50% {
      opacity: 0;
    }
  }

  .controles {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
  }

  nav {
    order: 3;
    width: 100%;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }

  nav a {
    display: inline-block;
    padding: 0.5rem 0.7rem;
    border-radius: var(--radio-sm);
    font-family: var(--fuente-mono);
    font-size: 0.875rem;
    color: var(--texto-suave);
    text-decoration: none;
  }

  nav a:hover {
    background: var(--bg-elev);
    color: var(--texto);
  }

  /* La sección en la que estás se marca con el acento relleno, no solo con color. */
  nav a[aria-current='page'] {
    background: var(--acento);
    color: var(--acento-sobre);
    font-weight: 600;
  }

  nav a[aria-current='page']:hover {
    background: var(--acento);
    color: var(--acento-sobre);
  }

  @media (min-width: 52rem) {
    nav {
      order: 0;
      width: auto;
    }
  }
</style>

<script>
  // Mide la cabecera y la publica como --altura-cabecera para que las anclas
  // (#reconocimiento, el índice del walkthrough…) no queden tapadas por ella.
  const cabecera = document.getElementById('cabecera');

  if (cabecera) {
    const raiz = document.documentElement;

    const medir = () => {
      raiz.style.setProperty('--altura-cabecera', `${cabecera.offsetHeight}px`);
    };

    medir();
    if ('ResizeObserver' in window) new ResizeObserver(medir).observe(cabecera);

    // Se oculta al bajar y vuelve al subir. Nunca mientras el foco está dentro
    // (navegación con teclado) ni cerca del principio de la página.
    let anterior = window.scrollY;

    window.addEventListener(
      'scroll',
      () => {
        const actual = window.scrollY;
        const bajando = actual > anterior;
        const margen = cabecera.offsetHeight * 2;

        if (!cabecera.contains(document.activeElement)) {
          cabecera.classList.toggle('oculta', bajando && actual > margen);
        }

        anterior = actual;
      },
      { passive: true },
    );
  }
</script>
