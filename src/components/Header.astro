---
import { NAVEGACION } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';

const ruta = Astro.url.pathname;

// "Inicio" solo está activo en "/"; el resto también en sus subpáginas.
function esActivo(href: string): boolean {
  if (href === '/') return ruta === '/';
  return ruta === href || ruta.startsWith(href);
}
---

<header class="cabecera">
  <div class="contenedor">
    <a href="/" class="logo" aria-label="Inicio">
      <span class="prompt-logo" aria-hidden="true">~/</span>ricardo<span class="cursor" aria-hidden="true">_</span>
    </a>

    <nav aria-label="Principal">
      <ul>
        {
          NAVEGACION.map(({ href, texto }) => (
            <li>
              <a href={href} aria-current={esActivo(href) ? 'page' : undefined}>
                {texto}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ThemeToggle />
  </div>
</header>

<style>
  .cabecera {
    border-bottom: 1px solid var(--borde);
    background: var(--bg-elev);
  }

  .contenedor {
    max-width: var(--ancho-max);
    margin-inline: auto;
    padding: 0.5rem var(--gutter);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
  }

  .logo {
    font-family: var(--fuente-mono);
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--texto);
    text-decoration: none;
    margin-right: auto;
  }

  .prompt-logo {
    color: var(--acento-texto);
  }

  .cursor {
    color: var(--acento-texto);
    animation: parpadeo 1.1s steps(1) infinite;
  }

  @keyframes parpadeo {
    50% {
      opacity: 0;
    }
  }

  nav {
    order: 3;
    width: 100%;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
  }

  nav a {
    display: inline-block;
    padding: 0.5rem 0.1rem;
    font-family: var(--fuente-mono);
    font-size: 0.95rem;
    color: var(--texto-suave);
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }

  nav a:hover {
    color: var(--texto);
  }

  nav a[aria-current='page'] {
    color: var(--acento-texto);
    border-bottom-color: var(--acento);
  }

  @media (min-width: 48rem) {
    nav {
      order: 0;
      width: auto;
    }
  }
</style>
