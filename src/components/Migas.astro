---
// Migas de pan semánticas: <nav aria-label> + <ol>. El último elemento es la
// página actual y lleva aria-current="page" (sin enlace).
//
// Los separadores los pone el CSS, así los lectores de pantalla no leen "/".
import { textos, type Idioma } from '../i18n';

export interface Miga {
  texto: string;
  /** Sin href = página actual. */
  href?: string;
}

interface Props {
  idioma: Idioma;
  migas: Miga[];
}

const { idioma, migas } = Astro.props;
const t = textos(idioma);
---

<nav class="migas" aria-label={t.general.migas}>
  <ol>
    {
      migas.map((miga) =>
        miga.href ? (
          <li>
            <a href={miga.href}>{miga.texto}</a>
          </li>
        ) : (
          <li aria-current="page">{miga.texto}</li>
        ),
      )
    }
  </ol>
</nav>

<style>
  .migas {
    margin: 0 0 var(--space-4);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
  }

  ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: inline-flex;
    align-items: center;
    overflow-wrap: anywhere;
  }

  li + li::before {
    content: '/';
    margin-inline: 0.5rem;
    color: var(--quiet);
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--accent-ink);
  }

  li[aria-current='page'] {
    color: var(--text);
  }
</style>
