---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Cmd from '../Cmd.astro';
import Pista from '../Pista.astro';
import { IDIOMA_POR_DEFECTO, IDIOMAS, etiquetaEstado, ruta, rutaHija, textos, type Idioma } from '../../i18n';
import type { Proyecto } from '../../lib/coleccion';
import { formatearFecha } from '../../lib/walkthroughs';

interface Props {
  proyecto: Proyecto;
  idioma: Idioma;
}

const { proyecto, idioma } = Astro.props;
const { data } = proyecto;
const t = textos(idioma);
const { Content } = await render(proyecto);

// El id del proyecto es el mismo en los dos idiomas: solo cambia el segmento.
const equivalentes = Object.fromEntries(
  IDIOMAS.map((otro) => [otro, rutaHija('proyectos', otro, proyecto.id)]),
) as Record<Idioma, string>;
---

<BaseLayout
  idioma={idioma}
  titulo={data.titulo}
  descripcion={data.resumen}
  equivalentes={equivalentes}
>
  <article class="lectura">
    {
      data.borrador && (
        <p class="franja-borrador" role="note">
          <strong>{t.general.borradorFuerte}</strong>: {t.general.borradorTexto}
        </p>
      )
    }

    {/* El texto del proyecto está en castellano: en inglés se avisa en lugar de disimularlo. */}
    {idioma !== IDIOMA_POR_DEFECTO && <p class="aviso-idioma" role="note">{t.aviso.contenidoEnOtroIdioma}</p>}

    <p class="migas">
      <a href={ruta('proyectos', idioma)}>{t.proyectos.migas}</a> <span aria-hidden="true">/</span> {proyecto.id}
    </p>

    <div class="cabecera-pagina">
      <h1>{data.titulo}</h1>
      <p>{data.resumen}</p>
    </div>

    <dl class="ficha">
      <div><dt>{t.proyectos.estado}</dt><dd>{etiquetaEstado(data.estado, idioma)}</dd></div>
      {
        data.fecha && (
          <div>
            <dt>{t.proyectos.fecha}</dt>
            <dd>
              <time datetime={data.fecha.toISOString().slice(0, 10)}>{formatearFecha(data.fecha, idioma)}</time>
            </dd>
          </div>
        )
      }
      <div><dt>{t.proyectos.tecnologias}</dt><dd>{data.tecnologias.join(' · ')}</dd></div>
      {
        data.repositorio && (
          <div>
            <dt>{t.proyectos.codigo}</dt>
            <dd><a href={data.repositorio}>{t.proyectos.repositorio}</a></dd>
          </div>
        )
      }
      {
        data.demo && (
          <div>
            <dt>{t.proyectos.demo}</dt>
            <dd><a href={data.demo}>{new URL(data.demo).host}</a></dd>
          </div>
        )
      }
    </dl>

    <div class="prosa">
      <Content components={{ Cmd, Pista }} />
    </div>
  </article>
</BaseLayout>

<style>
  .franja-borrador {
    margin: 0 0 1.5rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--peligro);
    border-radius: var(--radio);
    background: var(--peligro-bg);
    color: var(--peligro);
    font-family: var(--fuente-mono);
    font-size: 0.9rem;
  }

  .migas {
    margin: 0 0 1rem;
    font-family: var(--fuente-mono);
    font-size: 0.8rem;
    color: var(--texto-suave);
  }

  .migas a {
    text-decoration: none;
  }

  .migas a:hover {
    text-decoration: underline;
  }

  .ficha {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 0.9rem 1.25rem;
    margin: 0 0 2rem;
    padding: 1rem 1.15rem;
    border: 1px solid var(--borde);
    border-radius: var(--radio-lg);
    background: var(--bg-elev);
    font-family: var(--fuente-mono);
  }

  .ficha dt {
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--texto-suave);
  }

  .ficha dd {
    margin: 0.1rem 0 0;
    font-size: 0.85rem;
    overflow-wrap: anywhere;
  }

  .prosa :global(h2) {
    margin-top: 2.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--borde);
  }

  .prosa :global(blockquote) {
    margin: 1.25rem 0;
    padding: 0.75rem 1rem;
    border: 1px solid var(--borde);
    border-radius: var(--radio);
    background: var(--bg-elev);
    color: var(--texto-suave);
  }
</style>
