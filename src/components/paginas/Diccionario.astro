---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { HERRAMIENTAS, OPERADORES } from '../../data/comandos';
import { IDIOMA_POR_DEFECTO, etiquetaCategoria, rellenar, textos, type Idioma } from '../../i18n';
import { COBERTURA, TOTAL_HERRAMIENTAS, TOTAL_OPCIONES, TOTAL_OPERADORES } from '../../lib/diccionario';
import { enIdioma } from '../../lib/comando/texto';
import type { Categoria, Opcion, Texto } from '../../lib/comando/tipos';
import { slugTecnica } from '../../lib/walkthroughs';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const t = textos(idioma);

// Agrupadas por categoría y ordenadas alfabéticamente por el nombre que se ve.
const categorias = [...new Set(HERRAMIENTAS.map((h) => h.categoria))].sort((a, b) =>
  etiquetaCategoria(a, idioma).localeCompare(etiquetaCategoria(b, idioma), idioma),
);
const porCategoria = (c: Categoria) =>
  HERRAMIENTAS.filter((h) => h.categoria === c).sort((a, b) => a.nombre.localeCompare(b.nombre, 'es'));

/** El texto en el idioma de la página. */
const txt = (t: Texto) => enIdioma(t, idioma);

/**
 * Texto sobre el que busca el buscador: lleva los DOS idiomas, para que una
 * entrada ya traducida se encuentre igual buscando "puerto" que "port".
 */
const ambos = (t: Texto) => (typeof t === 'string' ? t : `${t.es} ${t.en}`);

const textoOpcion = (o: Opcion) =>
  [...o.nombres, ambos(o.descripcion), o.valor ? `${ambos(o.valor.nombre)} ${ambos(o.valor.descripcion)}` : ''].join(' ');
---

<BaseLayout idioma={idioma} titulo={t.diccionario.titulo} descripcion={t.diccionario.descripcion}>
  <div class="cabecera-pagina">
    <h1>{t.diccionario.titulo}</h1>
    <p
      set:html={rellenar(t.diccionario.introHtmlPlantilla, {
        herramientas: TOTAL_HERRAMIENTAS,
        opciones: TOTAL_OPCIONES,
        operadores: TOTAL_OPERADORES,
      })}
    />
  </div>

  {/*
    El aviso solo tiene sentido en inglés: en castellano el diccionario está
    completo. Mientras queden entradas sin traducir se dice cuántas van, y el
    número sale del propio diccionario.
  */}
  {
    idioma !== IDIOMA_POR_DEFECTO && !COBERTURA.completa && (
      <p class="aviso-idioma" role="note">
        {rellenar(t.aviso.diccionarioPlantilla, { traducidas: COBERTURA.traducidos, total: COBERTURA.total })}
      </p>
    )
  }

  <search
    class="buscador"
    data-buscador
    data-txt-resultado={t.diccionario.resultadoPlantilla}
    data-txt-resultado-una={t.diccionario.resultadoUnaPlantilla}
    hidden
  >
    <label for="consulta">{t.diccionario.buscarLabel}</label>
    <input
      id="consulta"
      type="search"
      class="campo"
      placeholder={t.diccionario.buscarPlaceholder}
      autocomplete="off"
    />
    <p class="contador" data-resultado aria-live="polite"></p>
  </search>

  <nav class="indice" aria-label={t.diccionario.herramientasAria}>
    <ul>
      {
        [...HERRAMIENTAS]
          .sort((a, b) => a.nombre.localeCompare(b.nombre, 'es'))
          .map((h) => (
            <li>
              <a href={`#${h.nombre}`}>{h.nombre}</a>
            </li>
          ))
      }
      <li><a href="#operadores">{t.diccionario.operadores}</a></li>
    </ul>
  </nav>

  {
    categorias.map((categoria) => (
      <section class="categoria" data-grupo aria-labelledby={`cat-${slugTecnica(categoria)}`}>
        <h2 id={`cat-${slugTecnica(categoria)}`}>{etiquetaCategoria(categoria, idioma)}</h2>

        {porCategoria(categoria).map((h) => (
          <article
            class="herramienta"
            id={h.nombre}
            data-herramienta
            data-texto={`${h.nombre} ${ambos(h.descripcion)} ${h.categoria} ${etiquetaCategoria(h.categoria, idioma)}`}
          >
            <h3>
              <code>{h.nombre}</code>
            </h3>
            <p>{txt(h.descripcion)}</p>
            {h.variantes && <p class="aviso">{t.general.ojo} {txt(h.variantes)}</p>}
            <p class="docs">
              <a href={h.docs} rel="noopener">{t.general.documentacionOficial}</a>
              {h.docsVariantes?.map((d) => (
                <>
                  {' · '}
                  <a href={d.url} rel="noopener">{d.nombre}</a>
                </>
              ))}
            </p>
            {h.argumentos && (
              <p class="argumentos">
                <span class="etiqueta-campo">{t.diccionario.argumentos}</span> {txt(h.argumentos)}
              </p>
            )}

            {h.opciones.length > 0 && (
              <dl class="opciones">
                {h.opciones.map((o) => (
                  <div class="opcion" data-opcion data-texto={textoOpcion(o)}>
                    <dt>
                      <code>{o.nombres.join(', ')}</code>
                      {o.valor && <span class="valor"> &lt;{txt(o.valor.nombre)}&gt;</span>}
                    </dt>
                    <dd>{txt(o.descripcion)}</dd>
                  </div>
                ))}
              </dl>
            )}

            {h.subcomandos?.map((s) => (
              <div class="subcomando">
                <h4>
                  <code>
                    {h.nombre} {s.nombre}
                  </code>
                </h4>
                <p>{txt(s.descripcion)}</p>
                <dl class="opciones">
                  {s.opciones.map((o) => (
                    <div class="opcion" data-opcion data-texto={`${s.nombre} ${textoOpcion(o)}`}>
                      <dt>
                        <code>{o.nombres.join(', ')}</code>
                        {o.valor && <span class="valor"> &lt;{txt(o.valor.nombre)}&gt;</span>}
                      </dt>
                      <dd>{txt(o.descripcion)}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            ))}
          </article>
        ))}
      </section>
    ))
  }

  <section class="categoria" data-grupo aria-labelledby="operadores">
    <h2 id="operadores">{t.diccionario.operadoresTitulo}</h2>
    <article class="herramienta" data-herramienta data-texto="operadores shell bash">
      <dl class="opciones">
        {
          OPERADORES.map((op) => (
            <div class="opcion" data-opcion data-texto={`${op.simbolo} ${ambos(op.nombre)} ${ambos(op.descripcion)}`}>
              <dt>
                <code>{op.simbolo}</code> <span class="valor">{txt(op.nombre)}</span>
              </dt>
              <dd>
                {txt(op.descripcion)} <a href={op.docs} rel="noopener">{t.diccionario.manualBash}</a>
              </dd>
            </div>
          ))
        }
      </dl>
    </article>
  </section>

  <p class="vacio" data-sin-resultados hidden>{t.diccionario.sinResultados}</p>
</BaseLayout>

<script>
  import { coincide } from '../../lib/buscar';

  const buscador = document.querySelector<HTMLElement>('[data-buscador]');
  // Los textos del contador vienen del data-* del buscador: este script es el
  // mismo para los dos idiomas (ver src/scripts/filtros.ts, misma idea).
  const txt = {
    varias: buscador?.dataset.txtResultado ?? '{secciones} / {entradas}',
    una: buscador?.dataset.txtResultadoUna ?? '{secciones} / {entradas}',
  };
  const rellena = (plantilla: string, valores: Record<string, number>) =>
    plantilla.replace(/\{(\w+)\}/g, (_, clave: string) => String(valores[clave] ?? ''));
  const input = buscador?.querySelector<HTMLInputElement>('input');
  const resultado = document.querySelector<HTMLElement>('[data-resultado]');
  const sinResultados = document.querySelector<HTMLElement>('[data-sin-resultados]');
  const grupos = [...document.querySelectorAll<HTMLElement>('[data-grupo]')];

  function filtrar() {
    const consulta = input?.value ?? '';
    let herramientasVisibles = 0;
    let opcionesVisibles = 0;

    for (const grupo of grupos) {
      let grupoVisible = false;
      for (const h of grupo.querySelectorAll<HTMLElement>('[data-herramienta]')) {
        // Si coincide la propia herramienta, se ven todas sus opciones.
        const coincideHerramienta = coincide(h.dataset.texto ?? '', consulta);
        let visiblesAqui = 0;
        for (const o of h.querySelectorAll<HTMLElement>('[data-opcion]')) {
          const visible = coincideHerramienta || coincide(o.dataset.texto ?? '', consulta);
          o.hidden = !visible;
          if (visible) visiblesAqui++;
        }
        // Oculta los subcomandos que se quedan sin opciones visibles.
        for (const s of h.querySelectorAll<HTMLElement>('.subcomando')) {
          s.hidden = !s.querySelector('[data-opcion]:not([hidden])');
        }
        const visible = coincideHerramienta || visiblesAqui > 0;
        h.hidden = !visible;
        if (visible) {
          herramientasVisibles++;
          opcionesVisibles += visiblesAqui;
          grupoVisible = true;
        }
      }
      grupo.hidden = !grupoVisible;
    }

    if (resultado) {
      resultado.textContent = consulta.trim()
        ? rellena(herramientasVisibles === 1 ? txt.una : txt.varias, {
            secciones: herramientasVisibles,
            entradas: opcionesVisibles,
          })
        : '';
    }
    if (sinResultados) sinResultados.hidden = herramientasVisibles > 0;
  }

  if (buscador && input) {
    buscador.hidden = false;
    input.addEventListener('input', filtrar);
  }
</script>

<style>
  .buscador {
    display: grid;
    gap: 0.35rem;
    margin: 0 0 1.25rem;
    max-width: 26rem;
  }

  .buscador[hidden] {
    display: none;
  }

  .buscador label {
    font-family: var(--fuente-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--texto-suave);
  }

  .contador {
    margin: 0;
    min-height: 1.4em;
    font-family: var(--fuente-mono);
    font-size: 0.8rem;
    color: var(--texto-suave);
  }

  .indice {
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--borde);
  }

  .indice ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .indice a {
    display: inline-block;
    min-height: 2.25rem;
    padding: 0.25rem 0.7rem;
    border: 1px solid var(--borde);
    border-radius: var(--radio-pill);
    background: var(--bg-elev);
    font-family: var(--fuente-mono);
    font-size: 0.8rem;
    color: var(--texto-suave);
    text-decoration: none;
  }

  .indice a:hover {
    border-color: var(--acento);
    color: var(--acento-texto);
  }

  [hidden] {
    display: none !important;
  }

  .categoria h2 {
    margin-top: 2.5rem;
  }

  .herramienta {
    border: 1px solid var(--borde);
    border-radius: var(--radio-lg);
    background: var(--bg-elev);
    padding: 1.1rem 1.35rem;
    margin: 1rem 0;
    scroll-margin-top: 1rem;
  }

  .herramienta h3 {
    margin: 0 0 0.25rem;
    font-size: 1.05rem;
    color: var(--tok-herramienta);
  }

  .herramienta > p {
    margin: 0.35rem 0;
  }

  .aviso {
    color: var(--acento2-texto);
  }

  .docs,
  .argumentos {
    font-size: 0.9rem;
  }

  .etiqueta-campo {
    font-family: var(--fuente-mono);
    color: var(--texto-suave);
  }

  .subcomando h4 {
    margin: 1.25rem 0 0.25rem;
    color: var(--tok-subcomando);
  }

  .opciones {
    margin: 0.75rem 0 0;
  }

  .opcion {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.1rem;
    padding: 0.5rem 0;
    border-top: 1px solid var(--borde-suave);
  }

  @media (min-width: 48rem) {
    .opcion {
      grid-template-columns: 16rem minmax(0, 1fr);
      gap: 1rem;
    }
  }

  .opcion dt code {
    color: var(--tok-opcion);
    overflow-wrap: anywhere;
  }

  .valor {
    font-family: var(--fuente-mono);
    font-size: 0.85rem;
    color: var(--tok-valor);
  }

  .opcion dd {
    margin: 0;
  }

</style>
