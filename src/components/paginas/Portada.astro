---
// Portada del Laboratorio. Orden fijo (ver design-exploration/CLAUDE_CODE_HANDOFF.md):
//   1. hero con tesis y CTA, y tarjeta de perfil;
//   2. búsqueda global, SIEMPRE antes que los casos;
//   3. franja de estado con cifras derivadas;
//   4. tres entradas: método, evidencia y referencia;
//   5. caso destacado real;
//   6. cadena de conocimiento con relaciones explicadas.
// Los principios de publicación responsable van en el pie (en todas las páginas).
import BaseLayout from '../../layouts/BaseLayout.astro';
import EvidenceHero from '../EvidenceHero.astro';
import EvidenceStrip, { type Cifra } from '../EvidenceStrip.astro';
import RutaConocimiento from '../RutaConocimiento.astro';
import { HERRAMIENTAS } from '../../data/comandos';
import {
  etiquetaEstado,
  rellenar,
  ruta,
  rutaHija,
  textos,
  type Idioma,
} from '../../i18n';
import { obtenerProyectos, obtenerWalkthroughs } from '../../lib/coleccion';
import { TOTAL_HERRAMIENTAS, TOTAL_OPCIONES } from '../../lib/diccionario';
import { primeraCadena } from '../../lib/relaciones';
import { agruparPorTecnica, formatearFecha, tecnicaEnIdioma } from '../../lib/walkthroughs';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const t = textos(idioma);
const p = t.portada;
const b = t.busqueda;

const walkthroughs = await obtenerWalkthroughs();
const proyectos = await obtenerProyectos();
const tecnicas = agruparPorTecnica(walkthroughs, idioma);

// ---------- Cifras: todas derivadas ----------
const cifras: Cifra[] = [
  {
    valor: walkthroughs.length,
    etiqueta: walkthroughs.length === 1 ? p.walkthrough : p.walkthroughs,
    href: ruta('walkthroughs', idioma),
  },
  { valor: tecnicas.length, etiqueta: tecnicas.length === 1 ? p.tecnica : p.tecnicas, href: ruta('tecnicas', idioma) },
  { valor: TOTAL_HERRAMIENTAS, etiqueta: p.herramientas, href: ruta('diccionario', idioma) },
  { valor: TOTAL_OPCIONES, etiqueta: p.opciones, href: ruta('diccionario', idioma) },
  { valor: proyectos.length, etiqueta: proyectos.length === 1 ? p.proyecto : p.proyectos, href: ruta('proyectos', idioma) },
];
const ultimo = walkthroughs[0];
if (ultimo) cifras.push({ valor: formatearFecha(ultimo.data.fecha, idioma), etiqueta: p.ultimo });

// ---------- Tres entradas ----------
// Método: el walkthrough más reciente.
const metodo = walkthroughs[0];
// Caso destacado: el Bot ChatOps (si existe); la entrada de evidencia, otro proyecto.
const destacado = proyectos.find((x) => x.id === 'chatops-bot-seguro') ?? proyectos[0];
// Prefiere uno en producción: es la prueba más directa de capacidad aplicada.
const otros = proyectos.filter((x) => x.id !== destacado?.id);
const evidencia = otros.find((x) => x.data.estado === 'En producción') ?? otros[0] ?? destacado;
// Referencia: nmap, la herramienta con la que empieza casi cada máquina.
const referencia = HERRAMIENTAS.find((h) => h.nombre === 'nmap') ?? HERRAMIENTAS[0];

// ---------- Cadena de conocimiento (derivada del walkthrough más reciente que la tenga) ----------
const cadena = primeraCadena(
  walkthroughs.map((w) => ({ id: w.id, ...w.data, body: w.body ?? '' })),
  idioma,
);

const EJEMPLOS = ['WinRM', 'nmap -p', 'HMAC', b.ejemploFtp, 'reverse shell'];
const enBiblioteca = (q: string) => `${ruta('biblioteca', idioma)}?q=${encodeURIComponent(q)}`;
---

<BaseLayout idioma={idioma}>
  <div class="portada">
    <EvidenceHero idioma={idioma} />

    <!-- Búsqueda: un formulario GET a la Biblioteca, funciona con y sin JavaScript. -->
    <section class="buscar" aria-labelledby="buscar-titulo">
      <h2 id="buscar-titulo" class="visually-hidden">{p.buscarTitulo}</h2>
      <form method="get" action={ruta('biblioteca', idioma)} role="search">
        <label class="visually-hidden" for="portada-consulta">{p.buscarTitulo}</label>
        <div class="caja-busqueda">
          <input
            id="portada-consulta"
            name="q"
            type="search"
            class="campo"
            autocomplete="off"
            spellcheck="false"
            placeholder={b.placeholder}
          />
          <button type="submit" class="boton boton-principal">{p.buscarBoton}</button>
        </div>
      </form>
      <ul class="ejemplos" aria-label={b.ejemplos}>
        {
          EJEMPLOS.map((e) => (
            <li>
              <a href={enBiblioteca(e)}>{e}</a>
            </li>
          ))
        }
      </ul>
    </section>

    <EvidenceStrip idioma={idioma} cifras={cifras} />

    <section class="entradas" aria-labelledby="entradas-titulo">
      <div class="titulo-seccion">
        <p class="eyebrow">{p.entradasEyebrow}</p>
        <h2 id="entradas-titulo">{p.entradasTitulo}</h2>
      </div>
      <ul class="rejilla-entradas">
        {
          metodo && (
            <li class="entrada entrada-metodo">
              <p class="tipo-entrada">01 · {p.metodo}</p>
              <h3>
                <a href={rutaHija('walkthroughs', idioma, metodo.id)}>{metodo.data.titulo}</a>
              </h3>
              <p class="explica">{p.metodoTexto}</p>
              <p>{metodo.data.resumen}</p>
              <ul class="chips" aria-label={t.general.tecnicasAria}>
                {metodo.data.tecnicas.map((c) => {
                  const tec = tecnicaEnIdioma(c, idioma);
                  return (
                    <li>
                      <a class="etiqueta" href={rutaHija('tecnicas', idioma, tec.slug)}>
                        {tec.nombre}
                      </a>
                    </li>
                  );
                })}
              </ul>
              <a class="mas" href={ruta('walkthroughs', idioma)}>
                {rellenar(p.verTodosPlantilla, { n: walkthroughs.length })} →
              </a>
            </li>
          )
        }
        {
          evidencia && (
            <li class="entrada entrada-evidencia">
              <p class="tipo-entrada">02 · {p.evidencia}</p>
              <h3>
                <a href={rutaHija('proyectos', idioma, evidencia.id)}>{evidencia.data.titulo}</a>
              </h3>
              <p class="explica">{p.evidenciaTexto}</p>
              <p>
                <span class="estado">{etiquetaEstado(evidencia.data.estado, idioma)}</span>
              </p>
              <p>{evidencia.data.resumen}</p>
              <a class="mas" href={ruta('proyectos', idioma)}>
                {rellenar(p.verTodosPlantilla, { n: proyectos.length })} →
              </a>
            </li>
          )
        }
        {
          referencia && (
            <li class="entrada entrada-referencia">
              <p class="tipo-entrada">03 · {p.referencia}</p>
              <h3>
                <a href={`${ruta('diccionario', idioma)}#${referencia.nombre}`}>
                  <code>{referencia.nombre}</code>
                </a>
              </h3>
              <p class="explica">
                {rellenar(p.referenciaPlantilla, { n: referencia.opciones.length, herramienta: referencia.nombre })}
              </p>
              <ul class="chips">
                {referencia.opciones.slice(0, 4).map((o) => (
                  <li>
                    <span class="etiqueta">{o.nombres[0]}</span>
                  </li>
                ))}
              </ul>
              <a class="mas" href={ruta('diccionario', idioma)}>
                {t.nav.diccionario} →
              </a>
            </li>
          )
        }
      </ul>
    </section>

    {
      destacado && (
        <section class="destacado" aria-labelledby="destacado-titulo">
          <p class="eyebrow">{p.destacadoEyebrow}</p>
          <h2 id="destacado-titulo">{destacado.data.titulo}</h2>
          <p class="estado">{etiquetaEstado(destacado.data.estado, idioma)}</p>
          <p class="resumen">{destacado.data.resumen}</p>
          <ul class="chips" aria-label={t.general.tecnologiasAria}>
            {destacado.data.tecnologias.map((x) => (
              <li>
                <span class="etiqueta">{x}</span>
              </li>
            ))}
          </ul>
          <a class="boton" href={rutaHija('proyectos', idioma, destacado.id)}>
            {p.verCaso}
          </a>
        </section>
      )
    }

    {
      cadena && (
        <section class="cadena" aria-labelledby="cadena-titulo">
          <div class="titulo-seccion">
            <p class="eyebrow">{p.cadenaEyebrow}</p>
            <h2 id="cadena-titulo">{p.cadenaTitulo}</h2>
            <p class="intro">{p.cadenaIntro}</p>
          </div>
          <RutaConocimiento idioma={idioma} nodos={cadena} />
        </section>
      )
    }

    <section class="sobre-mi" aria-labelledby="sobre-mi-titulo">
      <h2 id="sobre-mi-titulo">{p.sobreMi}</h2>
      <p set:html={p.sobreMi1Html} />
      <p set:html={p.sobreMi2Html} />
    </section>
  </div>
</BaseLayout>

<style>
  .portada {
    display: grid;
    gap: var(--space-12);
  }

  .titulo-seccion {
    margin-bottom: var(--space-6);
  }

  .titulo-seccion h2 {
    margin: 0;
  }

  .intro {
    max-width: var(--read);
    margin: var(--space-3) 0 0;
    color: var(--muted);
  }

  /* ---------- Búsqueda ---------- */
  .buscar {
    margin-top: calc(-1 * var(--space-8));
  }

  .buscar .caja-busqueda {
    padding-right: 0.4rem;
  }

  .buscar .boton {
    flex-shrink: 0;
  }

  .ejemplos {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
  }

  .ejemplos a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 0.8rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-s);
    background: var(--surface);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    text-decoration: none;
  }

  .ejemplos a:hover {
    border-color: var(--relation);
  }

  @media (max-width: 30rem) {
    .buscar .caja-busqueda {
      flex-wrap: wrap;
      padding: 0 0 0.4rem 0;
    }

    .buscar .boton {
      width: calc(100% - 0.8rem);
      margin-inline: 0.4rem;
    }
  }

  /* ---------- Tres entradas ---------- */
  .rejilla-entradas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .entrada {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-6);
    border: 1px solid var(--line);
    border-top: 0.35rem solid var(--accent);
    border-radius: var(--radius-l);
    background: var(--surface);
  }

  .entrada-evidencia {
    border-top-color: var(--relation);
  }

  .entrada-referencia {
    border-top-color: var(--text);
  }

  .entrada p {
    margin: 0;
  }

  .tipo-entrada {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .entrada h3 {
    margin: 0;
    font-size: 1.35rem;
  }

  .entrada h3 a {
    color: var(--text);
  }

  .explica {
    color: var(--muted);
    font-size: 0.95rem;
  }

  .mas {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    margin-top: auto;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .estado {
    display: inline-block;
    padding: 0.1rem 0.6rem;
    border: 1px solid var(--relation);
    border-radius: var(--radius-s);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--relation);
  }

  /* ---------- Caso destacado ---------- */
  .destacado {
    padding: clamp(1.25rem, 4vw, 2.5rem);
    border-radius: var(--radius-l);
    background: var(--text);
    color: var(--bg);
  }

  .destacado h2 {
    margin: 0 0 var(--space-3);
  }

  .destacado .eyebrow,
  .destacado .estado {
    color: var(--accent);
    border-color: var(--accent);
  }

  .destacado .resumen {
    max-width: var(--read);
    color: color-mix(in srgb, var(--bg) 80%, transparent);
  }

  .destacado .etiqueta {
    background: transparent;
    border-color: color-mix(in srgb, var(--bg) 40%, transparent);
    color: var(--bg);
  }

  .destacado .chips {
    margin-bottom: var(--space-6);
  }

  .destacado .boton {
    border-color: var(--bg);
    background: transparent;
    color: var(--bg);
  }

  .destacado .boton:hover {
    border-color: var(--accent);
  }

  /* ---------- Sobre mí ---------- */
  .sobre-mi {
    max-width: var(--read);
  }

  .sobre-mi h2 {
    margin-top: 0;
  }

  @media (forced-colors: active) {
    .entrada,
    .destacado {
      border: 1px solid CanvasText;
    }
  }
</style>
