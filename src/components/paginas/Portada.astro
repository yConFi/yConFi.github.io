---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Avatar from '../Avatar.astro';
import TarjetaWalkthrough from '../TarjetaWalkthrough.astro';
import TarjetaProyecto from '../TarjetaProyecto.astro';
import BotonUtil from '../BotonUtil.astro';
import { ENLACES } from '../../data/site';
import { rellenar, ruta, textos, type Idioma } from '../../i18n';
import { obtenerProyectos, obtenerWalkthroughs } from '../../lib/coleccion';
import { TOTAL_HERRAMIENTAS, TOTAL_OPCIONES } from '../../lib/diccionario';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const t = textos(idioma);
const walkthroughs = await obtenerWalkthroughs();
const proyectos = await obtenerProyectos();
const ultimosWalkthroughs = walkthroughs.slice(0, 3);
const ultimosProyectos = proyectos.slice(0, 2);

// Todas las cifras salen del contenido publicado: nunca se escriben a mano.
const contadores = [
  {
    valor: walkthroughs.length,
    etiqueta: walkthroughs.length === 1 ? t.portada.maquinaResuelta : t.portada.maquinasResueltas,
  },
  { valor: TOTAL_HERRAMIENTAS, etiqueta: t.portada.herramientasExplicadas },
  { valor: TOTAL_OPCIONES, etiqueta: t.portada.opcionesDiccionario },
  { valor: proyectos.length, etiqueta: proyectos.length === 1 ? t.portada.proyecto : t.portada.proyectos },
];
---

<BaseLayout idioma={idioma} anchoCompleto>
  <section class="banda" aria-labelledby="titulo-inicio">
    <div class="contenido portada">
      <div class="presentacion">
        <div class="identidad">
          <Avatar idioma={idioma} />
          <div>
            <p class="alias">yConFi</p>
            <h1 id="titulo-inicio">Ricardo Hidalgo</h1>
          </div>
        </div>
        <p class="lema" set:html={t.portada.lemaHtml} />
        <p class="pitch" set:html={t.portada.pitchHtml} />
        <div class="acciones">
          <a class="boton boton-principal" href={ruta('walkthroughs', idioma)}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m4 17 6-5-6-5"></path>
              <path d="M12 19h8"></path>
            </svg>
            {t.portada.verWalkthroughs}
          </a>
          <a class="boton" href={ENLACES.linkedin} rel="me">LinkedIn</a>
          <a class="boton" href={ENLACES.github} rel="me">GitHub</a>
        </div>
      </div>

      <div class="terminal">
        <div class="terminal-barra">
          <span class="punto" aria-hidden="true"></span>
          {t.portada.terminal.barra}
        </div>
        <div class="terminal-cuerpo">
          <p class="orden"><span aria-hidden="true">$</span> whoami</p>
          <p class="salida">{t.portada.terminal.whoami}</p>
          <p class="orden"><span aria-hidden="true">$</span> {t.portada.terminal.ordenObjetivo}</p>
          <p class="salida">{t.portada.terminal.objetivo}</p>
          <p class="orden"><span aria-hidden="true">$</span> {t.portada.terminal.ordenFormacion}</p>
          <p class="salida">
            {t.portada.terminal.formacion1} <span class="tenue">{t.portada.terminal.formacion1Fecha}</span>
          </p>
          <p class="salida">
            {t.portada.terminal.formacion2} <span class="tenue">{t.portada.terminal.formacion2Fecha}</span>
          </p>
          <p class="orden"><span aria-hidden="true">$</span> <span class="cursor" aria-hidden="true"></span></p>
        </div>
      </div>
    </div>
  </section>

  <section class="banda" aria-label={t.portada.cifrasAria}>
    <div class="contenido">
      <ul class="contadores">
        {
          contadores.map((c) => (
            <li>
              <span class="numero">{c.valor}</span>
              <span class="etiqueta-contador">{c.etiqueta}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    ultimosWalkthroughs.length > 0 && (
      <section class="banda" aria-labelledby="titulo-walkthroughs">
        <div class="contenido">
          <div class="titulo-seccion">
            <h2 id="titulo-walkthroughs">{t.portada.ultimasMaquinas}</h2>
            <a href={ruta('walkthroughs', idioma)}>
              {rellenar(t.portada.verTodasPlantilla, { n: walkthroughs.length })}
            </a>
          </div>
          <div class="rejilla rejilla-3">
            {ultimosWalkthroughs.map((w) => (
              <TarjetaWalkthrough walkthrough={w} idioma={idioma} nivel="h3" />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    ultimosProyectos.length > 0 && (
      <section class="banda" aria-labelledby="titulo-proyectos">
        <div class="contenido">
          <div class="titulo-seccion">
            <h2 id="titulo-proyectos">{t.portada.proyectos}</h2>
            <a href={ruta('proyectos', idioma)}>
              {rellenar(t.portada.verTodosPlantilla, { n: proyectos.length })}
            </a>
          </div>
          <div class="rejilla rejilla-2">
            {ultimosProyectos.map((p) => (
              <TarjetaProyecto proyecto={p} idioma={idioma} nivel="h3" />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="banda" aria-labelledby="titulo-sobre-mi">
    <div class="contenido sobre-mi">
      <div class="lectura">
        <h2 id="titulo-sobre-mi">{t.portada.sobreMi}</h2>
        <p set:html={t.portada.sobreMi1Html} />
        <p set:html={t.portada.sobreMi2Html} />
      </div>

      <aside class="tarjeta contacto">
        <h2>{t.portada.contacto}</h2>
        <ul>
          <li><a href={ENLACES.linkedin} rel="me">LinkedIn</a></li>
          <li><a href={ENLACES.github} rel="me">GitHub · yConFi</a></li>
          <li><a href={ruta('logros', idioma)}>{t.portada.logrosYPlataformas}</a></li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="banda banda-final" aria-labelledby="titulo-util">
    <div class="contenido">
      <BotonUtil idioma={idioma} />
    </div>
  </section>
</BaseLayout>

<style>
  .banda {
    border-bottom: 1px solid var(--borde);
  }

  .banda-final {
    border-bottom: 0;
  }

  .contenido {
    max-width: var(--ancho-max);
    margin-inline: auto;
    padding: 3rem var(--gutter);
  }

  /* ---------- Presentación ---------- */
  .portada {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2.5rem 3.5rem;
  }

  .presentacion {
    flex: 1 1 25rem;
    min-width: 0;
  }

  .identidad {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    margin-bottom: 1.4rem;
  }

  .alias {
    margin: 0;
    font-family: var(--fuente-mono);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    color: var(--acento-texto);
  }

  .identidad h1 {
    margin: 0.15rem 0 0;
  }

  .lema {
    margin: 0 0 0.85rem;
    font-size: 1.3rem;
    line-height: 1.4;
  }

  .pitch {
    margin: 0 0 1.75rem;
    max-width: 34rem;
    color: var(--texto-suave);
  }

  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .acciones svg {
    width: 1.05rem;
    height: 1.05rem;
  }

  /* ---------- Ventana de terminal ---------- */
  .terminal {
    flex: 1 1 24rem;
    min-width: 0;
    border: 1px solid var(--borde);
    border-radius: var(--radio-lg);
    background: var(--bg-code);
    overflow: hidden;
  }

  .terminal-barra {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 1rem;
    border-bottom: 1px solid var(--borde);
    background: var(--bg-elev);
    font-family: var(--fuente-mono);
    font-size: 0.75rem;
    color: var(--texto-suave);
  }

  .punto {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--acento);
  }

  .terminal-cuerpo {
    padding: 1.1rem 1.25rem 1.3rem;
    font-family: var(--fuente-mono);
    font-size: 0.85rem;
    line-height: 1.85;
  }

  .orden {
    margin: 0;
    color: var(--texto-suave);
  }

  .orden span[aria-hidden] {
    color: var(--acento);
  }

  .salida {
    margin: 0;
    font-family: var(--fuente-texto);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .salida + .orden {
    margin-top: 0.9rem;
  }

  .tenue {
    color: var(--texto-suave);
  }

  .cursor {
    display: inline-block;
    width: 0.5rem;
    height: 1.05em;
    vertical-align: text-bottom;
    background: var(--acento);
    animation: parpadeo 1.1s steps(1) infinite;
  }

  @keyframes parpadeo {
    50% {
      opacity: 0;
    }
  }

  /* ---------- Contadores ---------- */
  .contadores {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 1.5rem 2rem;
  }

  .contadores li {
    display: flex;
    flex-direction: column;
  }

  .numero {
    font-family: var(--fuente-mono);
    font-size: 2rem;
    font-weight: 600;
    line-height: 1.1;
    color: var(--acento-texto);
  }

  .etiqueta-contador {
    font-size: 0.9rem;
    color: var(--texto-suave);
  }

  /* ---------- Secciones de listas ---------- */
  .titulo-seccion {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1rem;
    margin-bottom: 1.25rem;
  }

  .titulo-seccion h2 {
    margin: 0;
    flex-grow: 1;
  }

  .titulo-seccion a {
    font-family: var(--fuente-mono);
    font-size: 0.85rem;
    text-decoration: none;
  }

  .titulo-seccion a:hover {
    text-decoration: underline;
  }

  .rejilla {
    display: grid;
    gap: 1rem;
  }

  .rejilla-3 {
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
  }

  .rejilla-2 {
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
  }

  /* ---------- Sobre mí ---------- */
  .sobre-mi {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem 3rem;
    align-items: flex-start;
  }

  .sobre-mi .lectura {
    flex: 999 1 28rem;
    min-width: 0;
  }

  .sobre-mi h2 {
    margin-top: 0;
  }

  .contacto {
    flex: 1 1 15rem;
    min-width: 0;
  }

  .contacto h2 {
    margin: 0 0 0.75rem;
    font-size: 1.05rem;
  }

  .contacto ul {
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--fuente-mono);
    font-size: 0.9rem;
  }

  .contacto li + li {
    margin-top: 0.4rem;
  }

  .contacto a {
    display: inline-block;
    padding: 0.2rem 0;
  }
</style>
