---
// Botón de tema. Por defecto manda el tema del sistema; al pulsarlo se fija uno
// y se guarda en localStorage. BaseLayout lo aplica antes de pintar.
// Qué icono y qué etiqueta se ven lo decide el CSS, para que sea correcto
// incluso antes de que cargue el JavaScript.
---

<button type="button" class="theme-toggle" data-theme-toggle>
  <svg class="icono a-oscuro" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
  </svg>
  <svg class="icono a-claro" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"></path>
  </svg>
  <span class="visually-hidden a-oscuro">Cambiar a tema oscuro</span>
  <span class="visually-hidden a-claro">Cambiar a tema claro</span>
</button>

<script>
  const boton = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const sistemaOscuro = window.matchMedia('(prefers-color-scheme: dark)');

  boton?.addEventListener('click', () => {
    const actual = document.documentElement.dataset.theme ?? (sistemaOscuro.matches ? 'dark' : 'light');
    const nuevo = actual === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = nuevo;
    try {
      localStorage.setItem('tema', nuevo);
    } catch {
      /* almacenamiento no disponible: el cambio dura solo esta visita */
    }
  });
</script>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    flex-shrink: 0;
    background: var(--bg-elev);
    color: var(--texto-suave);
    border: 1px solid var(--borde);
    border-radius: var(--radio);
    cursor: pointer;
  }

  .theme-toggle:hover {
    border-color: var(--acento);
    color: var(--texto);
  }

  .icono {
    width: 1.1rem;
    height: 1.1rem;
  }

  /* Por defecto (tema claro) se ofrece pasar a oscuro. */
  .a-claro {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .a-oscuro {
      display: none;
    }

    :global(:root:not([data-theme='light'])) .a-claro {
      display: block;
    }
  }

  :global(:root[data-theme='dark']) .a-oscuro {
    display: none;
  }

  :global(:root[data-theme='dark']) .a-claro {
    display: block;
  }
</style>
