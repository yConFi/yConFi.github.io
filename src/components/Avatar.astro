---
// Marca personal de la portada: el avatar ilustrado de Ricardo.
// Para cambiarlo basta con sustituir la imagen de src/assets/avatar/.
import { Image } from 'astro:assets';
import avatar from '../assets/avatar/ricardo.webp';
import { textos, type Idioma } from '../i18n';

interface Props {
  idioma: Idioma;
  /** Lado del círculo. Por defecto 5.5rem. */
  tamano?: string;
  /** Lado en píxeles que se le pide a Astro al optimizar (el doble, para pantallas densas). */
  ancho?: number;
}

const { idioma, tamano = '5.5rem', ancho = 256 } = Astro.props;
const t = textos(idioma);
---

<Image
  class="avatar"
  style={`--lado: ${tamano}`}
  src={avatar}
  width={ancho}
  height={ancho}
  alt={t.general.avatarAlt}
  loading="eager"
/>

<style>
  .avatar {
    width: var(--lado);
    height: var(--lado);
    flex-shrink: 0;
    border-radius: 50%;
    border: 2px solid var(--acento);
    object-fit: cover;
    background: var(--acento-bg);
  }
</style>
