---
import BaseLayout from '../layouts/BaseLayout.astro';
import { obtenerCertificaciones } from '../lib/coleccion';
import { formatearFecha } from '../lib/walkthroughs';
import { PERFILES } from '../data/site';

const certificaciones = await obtenerCertificaciones();
const iso = (fecha: Date) => fecha.toISOString().slice(0, 10);
---

<BaseLayout titulo="Logros" descripcion="Certificaciones conseguidas y progreso en plataformas de práctica de ciberseguridad.">
  <div class="cabecera-pagina">
    <h1>Logros</h1>
    <p>Certificaciones que he conseguido y mi progreso en plataformas de práctica.</p>
  </div>

  <section aria-labelledby="titulo-certificaciones">
    <h2 id="titulo-certificaciones">Certificaciones</h2>
    {
      certificaciones.length === 0 ? (
        <p class="vacio">
          Todavía no tengo ninguna certificación. Mientras tanto, lo que voy aprendiendo está en los{' '}
          <a href="/walkthroughs/">walkthroughs</a>.
        </p>
      ) : (
        <ul class="rejilla">
          {certificaciones.map(({ data }) => (
            <li class="tarjeta">
              <h3 class="titulo">
                {data.titulo}
                {data.borrador && <span class="borrador">borrador</span>}
              </h3>
              <p class="meta">
                {data.emisor} · <time datetime={iso(data.fecha)}>{formatearFecha(data.fecha)}</time>
              </p>
              {data.credencial && (
                <p class="enlace">
                  <a href={data.credencial}>Verificar credencial</a>
                </p>
              )}
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <section aria-labelledby="titulo-plataformas">
    <h2 id="titulo-plataformas">Plataformas</h2>
    <ul class="rejilla">
      {
        PERFILES.map((p) => (
          <li class="tarjeta">
            <h3 class="titulo">{p.nombre}</h3>
            {p.rango && (
              <p class="meta">
                Rango: <strong>{p.rango.nombre}</strong> · actualizado el{' '}
                <time datetime={p.rango.actualizado}>{formatearFecha(new Date(p.rango.actualizado))}</time>
              </p>
            )}
            <p class="enlace">
              <a href={p.url} rel="me">
                Ver mi perfil en {p.nombre}
              </a>
            </p>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  section + section {
    margin-top: 2.5rem;
  }

  section h2 {
    margin-top: 0;
  }

  .rejilla {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 1rem;
  }

  .titulo {
    margin: 0;
    font-size: 1.15rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .borrador {
    font-family: var(--fuente-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.1rem 0.45rem;
    border-radius: var(--radio-pill);
    border: 1px solid var(--peligro);
    color: var(--peligro);
  }

  .meta {
    margin: 0.4rem 0 0;
    font-family: var(--fuente-mono);
    font-size: 0.8rem;
    color: var(--texto-suave);
  }

  .enlace {
    margin: 0.75rem 0 0;
    font-family: var(--fuente-mono);
    font-size: 0.85rem;
  }

  .enlace a {
    display: inline-block;
    padding: 0.2rem 0;
  }
</style>
