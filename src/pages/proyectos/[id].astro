---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Cmd from '../../components/Cmd.astro';
import Pista from '../../components/Pista.astro';
import { obtenerProyectos, type Proyecto } from '../../lib/coleccion';
import { formatearFecha } from '../../lib/walkthroughs';

export async function getStaticPaths() {
  const proyectos = await obtenerProyectos();
  return proyectos.map((proyecto) => ({ params: { id: proyecto.id }, props: { proyecto } }));
}

interface Props {
  proyecto: Proyecto;
}

const { proyecto } = Astro.props;
const { data } = proyecto;
const { Content } = await render(proyecto);
---

<BaseLayout titulo={data.titulo} descripcion={data.resumen}>
  <article class="lectura">
    {
      data.borrador && (
        <p class="franja-borrador" role="note">
          <strong>BORRADOR</strong>: solo se ve en desarrollo y no se publicará.
        </p>
      )
    }

    <p class="migas"><a href="/proyectos/">proyectos</a> <span aria-hidden="true">/</span> {proyecto.id}</p>

    <div class="cabecera-pagina">
      <h1>{data.titulo}</h1>
      <p>{data.resumen}</p>
    </div>

    <dl class="ficha">
      <div><dt>Estado</dt><dd>{data.estado}</dd></div>
      {
        data.fecha && (
          <div>
            <dt>Fecha</dt>
            <dd><time datetime={data.fecha.toISOString().slice(0, 10)}>{formatearFecha(data.fecha)}</time></dd>
          </div>
        )
      }
      <div><dt>Tecnologías</dt><dd>{data.tecnologias.join(' · ')}</dd></div>
      {
        data.repositorio && (
          <div>
            <dt>Código</dt>
            <dd><a href={data.repositorio}>Repositorio</a></dd>
          </div>
        )
      }
      {
        data.demo && (
          <div>
            <dt>Demo</dt>
            <dd><a href={data.demo}>{new URL(data.demo).host}</a></dd>
          </div>
        )
      }
    </dl>

    <div class="prosa">
      <Content components={{ Cmd, Pista }} />
    </div>
  </article>
</BaseLayout>

<style>
  .franja-borrador {
    margin: 0 0 1.5rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--peligro);
    border-radius: var(--radio);
    background: var(--peligro-bg);
    color: var(--peligro);
    font-family: var(--fuente-mono);
    font-size: 0.9rem;
  }

  .migas {
    margin: 0 0 1rem;
    font-family: var(--fuente-mono);
    font-size: 0.8rem;
    color: var(--texto-suave);
  }

  .migas a {
    text-decoration: none;
  }

  .migas a:hover {
    text-decoration: underline;
  }

  .ficha {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 0.9rem 1.25rem;
    margin: 0 0 2rem;
    padding: 1rem 1.15rem;
    border: 1px solid var(--borde);
    border-radius: var(--radio-lg);
    background: var(--bg-elev);
    font-family: var(--fuente-mono);
  }

  .ficha dt {
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--texto-suave);
  }

  .ficha dd {
    margin: 0.1rem 0 0;
    font-size: 0.85rem;
    overflow-wrap: anywhere;
  }

  .prosa :global(h2) {
    margin-top: 2.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--borde);
  }

  .prosa :global(blockquote) {
    margin: 1.25rem 0;
    padding: 0.75rem 1rem;
    border: 1px solid var(--borde);
    border-radius: var(--radio);
    background: var(--bg-elev);
    color: var(--texto-suave);
  }
</style>
