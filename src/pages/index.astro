---
import BaseLayout from '../layouts/BaseLayout.astro';
import Avatar from '../components/Avatar.astro';
import TarjetaWalkthrough from '../components/TarjetaWalkthrough.astro';
import TarjetaProyecto from '../components/TarjetaProyecto.astro';
import { obtenerProyectos, obtenerWalkthroughs } from '../lib/coleccion';
import { TOTAL_HERRAMIENTAS, TOTAL_OPCIONES } from '../lib/diccionario';
import { ENLACES } from '../data/site';

const walkthroughs = await obtenerWalkthroughs();
const proyectos = await obtenerProyectos();
const ultimosWalkthroughs = walkthroughs.slice(0, 3);
const ultimosProyectos = proyectos.slice(0, 2);

// Todas las cifras salen del contenido publicado: nunca se escriben a mano.
const contadores = [
  { valor: walkthroughs.length, etiqueta: walkthroughs.length === 1 ? 'máquina resuelta' : 'máquinas resueltas' },
  { valor: TOTAL_HERRAMIENTAS, etiqueta: 'herramientas explicadas' },
  { valor: TOTAL_OPCIONES, etiqueta: 'opciones en el diccionario' },
  { valor: proyectos.length, etiqueta: proyectos.length === 1 ? 'proyecto' : 'proyectos' },
];
---

<BaseLayout anchoCompleto>
  <section class="banda" aria-labelledby="titulo-inicio">
    <div class="contenido portada">
      <div class="presentacion">
        <div class="identidad">
          <Avatar />
          <div>
            <p class="alias">yConFi</p>
            <h1 id="titulo-inicio">Ricardo Hidalgo</h1>
          </div>
        </div>
        <p class="lema">Estoy haciendo el camino hacia la <strong>ciberseguridad</strong>.</p>
        <p class="pitch">
          Aquí publico mis proyectos y los walkthroughs de las máquinas y retos <strong>retirados</strong> que voy
          resolviendo, con cada parte de cada comando explicada.
        </p>
        <div class="acciones">
          <a class="boton boton-principal" href="/walkthroughs/">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m4 17 6-5-6-5"></path>
              <path d="M12 19h8"></path>
            </svg>
            Ver los walkthroughs
          </a>
          <a class="boton" href={ENLACES.linkedin} rel="me">LinkedIn</a>
          <a class="boton" href={ENLACES.github} rel="me">GitHub</a>
        </div>
      </div>

      <div class="terminal">
        <div class="terminal-barra">
          <span class="punto" aria-hidden="true"></span>
          ricardo@yconfi: ~ — bash
        </div>
        <div class="terminal-cuerpo">
          <p class="orden"><span aria-hidden="true">$</span> whoami</p>
          <p class="salida">ricardo · estudiante de ciberseguridad</p>
          <p class="orden"><span aria-hidden="true">$</span> cat objetivo.txt</p>
          <p class="salida">
            Lo que busco, sobre todo, es aprender. Y cuando se me dé la oportunidad, trabajar en ello para aprender
            aún más.
          </p>
          <p class="orden"><span aria-hidden="true">$</span> ls formacion/</p>
          <p class="salida">ASIR · LinkiaFP <span class="tenue">→ sep 2027</span></p>
          <p class="salida">Máster en Ciberseguridad &amp; IA · Evolve <span class="tenue">→ abr 2027</span></p>
          <p class="orden"><span aria-hidden="true">$</span> <span class="cursor" aria-hidden="true"></span></p>
        </div>
      </div>
    </div>
  </section>

  <section class="banda" aria-label="En cifras">
    <div class="contenido">
      <ul class="contadores">
        {
          contadores.map((c) => (
            <li>
              <span class="numero">{c.valor}</span>
              <span class="etiqueta-contador">{c.etiqueta}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    ultimosWalkthroughs.length > 0 && (
      <section class="banda" aria-labelledby="titulo-walkthroughs">
        <div class="contenido">
          <div class="titulo-seccion">
            <h2 id="titulo-walkthroughs">Últimas máquinas</h2>
            <a href="/walkthroughs/">ver todas ({walkthroughs.length}) →</a>
          </div>
          <div class="rejilla rejilla-3">
            {ultimosWalkthroughs.map((w) => (
              <TarjetaWalkthrough walkthrough={w} nivel="h3" />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    ultimosProyectos.length > 0 && (
      <section class="banda" aria-labelledby="titulo-proyectos">
        <div class="contenido">
          <div class="titulo-seccion">
            <h2 id="titulo-proyectos">Proyectos</h2>
            <a href="/proyectos/">ver todos ({proyectos.length}) →</a>
          </div>
          <div class="rejilla rejilla-2">
            {ultimosProyectos.map((p) => (
              <TarjetaProyecto proyecto={p} nivel="h3" />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="banda banda-final" aria-labelledby="titulo-sobre-mi">
    <div class="contenido sobre-mi">
      <div class="lectura">
        <h2 id="titulo-sobre-mi">Sobre mí</h2>
        <p>
          Decidí estudiar ciberseguridad por curiosidad y porque es algo que siempre me ha llamado la atención.
          Empezó cuando tenía unos 12 años, jugando al famoso <em>Habbo</em>.
        </p>
        <p>
          Lo que busco, sobre todo, es <strong>aprender</strong>. Y cuando se me dé la oportunidad, trabajar en ello
          para aprender aún más. Por eso explico cada comando parte por parte: para entender bien cada paso y que
          también le sirvan a otros.
        </p>
      </div>

      <aside class="tarjeta contacto">
        <h2>Contacto</h2>
        <ul>
          <li><a href={ENLACES.linkedin} rel="me">LinkedIn</a></li>
          <li><a href={ENLACES.github} rel="me">GitHub · yConFi</a></li>
          <li><a href="/logros/">Logros y plataformas</a></li>
        </ul>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .banda {
    border-bottom: 1px solid var(--borde);
  }

  .banda-final {
    border-bottom: 0;
  }

  .contenido {
    max-width: var(--ancho-max);
    margin-inline: auto;
    padding: 3rem var(--gutter);
  }

  /* ---------- Presentación ---------- */
  .portada {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2.5rem 3.5rem;
  }

  .presentacion {
    flex: 1 1 25rem;
    min-width: 0;
  }

  .identidad {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    margin-bottom: 1.4rem;
  }

  .alias {
    margin: 0;
    font-family: var(--fuente-mono);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    color: var(--acento-texto);
  }

  .identidad h1 {
    margin: 0.15rem 0 0;
  }

  .lema {
    margin: 0 0 0.85rem;
    font-size: 1.3rem;
    line-height: 1.4;
  }

  .pitch {
    margin: 0 0 1.75rem;
    max-width: 34rem;
    color: var(--texto-suave);
  }

  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .acciones svg {
    width: 1.05rem;
    height: 1.05rem;
  }

  /* ---------- Ventana de terminal ---------- */
  .terminal {
    flex: 1 1 24rem;
    min-width: 0;
    border: 1px solid var(--borde);
    border-radius: var(--radio-lg);
    background: var(--bg-code);
    overflow: hidden;
  }

  .terminal-barra {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 1rem;
    border-bottom: 1px solid var(--borde);
    background: var(--bg-elev);
    font-family: var(--fuente-mono);
    font-size: 0.75rem;
    color: var(--texto-suave);
  }

  .punto {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--acento);
  }

  .terminal-cuerpo {
    padding: 1.1rem 1.25rem 1.3rem;
    font-family: var(--fuente-mono);
    font-size: 0.85rem;
    line-height: 1.85;
  }

  .orden {
    margin: 0;
    color: var(--texto-suave);
  }

  .orden span[aria-hidden] {
    color: var(--acento);
  }

  .salida {
    margin: 0;
    font-family: var(--fuente-texto);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .salida + .orden {
    margin-top: 0.9rem;
  }

  .tenue {
    color: var(--texto-suave);
  }

  .cursor {
    display: inline-block;
    width: 0.5rem;
    height: 1.05em;
    vertical-align: text-bottom;
    background: var(--acento);
    animation: parpadeo 1.1s steps(1) infinite;
  }

  @keyframes parpadeo {
    50% {
      opacity: 0;
    }
  }

  /* ---------- Contadores ---------- */
  .contadores {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 1.5rem 2rem;
  }

  .contadores li {
    display: flex;
    flex-direction: column;
  }

  .numero {
    font-family: var(--fuente-mono);
    font-size: 2rem;
    font-weight: 600;
    line-height: 1.1;
    color: var(--acento-texto);
  }

  .etiqueta-contador {
    font-size: 0.9rem;
    color: var(--texto-suave);
  }

  /* ---------- Secciones de listas ---------- */
  .titulo-seccion {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1rem;
    margin-bottom: 1.25rem;
  }

  .titulo-seccion h2 {
    margin: 0;
    flex-grow: 1;
  }

  .titulo-seccion a {
    font-family: var(--fuente-mono);
    font-size: 0.85rem;
    text-decoration: none;
  }

  .titulo-seccion a:hover {
    text-decoration: underline;
  }

  .rejilla {
    display: grid;
    gap: 1rem;
  }

  .rejilla-3 {
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
  }

  .rejilla-2 {
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
  }

  /* ---------- Sobre mí ---------- */
  .sobre-mi {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem 3rem;
    align-items: flex-start;
  }

  .sobre-mi .lectura {
    flex: 999 1 28rem;
    min-width: 0;
  }

  .sobre-mi h2 {
    margin-top: 0;
  }

  .contacto {
    flex: 1 1 15rem;
    min-width: 0;
  }

  .contacto h2 {
    margin: 0 0 0.75rem;
    font-size: 1.05rem;
  }

  .contacto ul {
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--fuente-mono);
    font-size: 0.9rem;
  }

  .contacto li + li {
    margin-top: 0.4rem;
  }

  .contacto a {
    display: inline-block;
    padding: 0.2rem 0;
  }
</style>
