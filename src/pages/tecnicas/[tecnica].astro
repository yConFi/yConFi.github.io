---
// Esta ruta solo elige el idioma: la página está en src/components/paginas/Tecnica.astro.
// Los slugs son los del castellano (/tecnicas/escaneo-de-puertos/).
import Tecnica from '../../components/paginas/Tecnica.astro';
import { obtenerWalkthroughs } from '../../lib/coleccion';
import { agruparPorTecnica } from '../../lib/walkthroughs';

export async function getStaticPaths() {
  const tecnicas = agruparPorTecnica(await obtenerWalkthroughs(), 'es');
  return tecnicas.map((tecnica) => ({ params: { tecnica: tecnica.slug }, props: { tecnica } }));
}

const { tecnica } = Astro.props;
---

<Tecnica tecnica={tecnica} idioma="es" />
