---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Cmd from '../../components/Cmd.astro';
import Pista from '../../components/Pista.astro';
import Ruta from '../../components/Ruta.astro';
import { obtenerWalkthroughs } from '../../lib/coleccion';
import { comprobarSecciones, formatearFecha, nombreSerie, slugTecnica, type Walkthrough } from '../../lib/walkthroughs';

export async function getStaticPaths() {
  const lista = await obtenerWalkthroughs();
  return lista.map((walkthrough) => ({ params: { id: walkthrough.id }, props: { walkthrough } }));
}

interface Props {
  walkthrough: Walkthrough;
}

const { walkthrough } = Astro.props;
const { data } = walkthrough;
const { Content, headings } = await render(walkthrough);
comprobarSecciones(walkthrough.id, headings);

const indice = headings.filter((h) => h.depth === 2);
const numero = (i: number) => String(i + 1).padStart(2, '0');
---

<BaseLayout titulo={data.titulo} descripcion={data.resumen}>
  <article class="walkthrough">
    {
      data.borrador && (
        <p class="franja-borrador" role="note">
          <strong>BORRADOR</strong>: solo se ve en desarrollo y no se publicará.
        </p>
      )
    }

    <header class="cabecera">
      <p class="migas"><a href="/walkthroughs/">walkthroughs</a> <span aria-hidden="true">/</span> {walkthrough.id}</p>

      <div class="presentacion">
        <div class="identidad">
          <div class="linea-titulo">
            <h1>{data.titulo}</h1>
            <span class={`dificultad dificultad-${slugTecnica(data.dificultad)}`}>{data.dificultad}</span>
          </div>
          <p class="resumen">{data.resumen}</p>
        </div>

        <dl class="ficha">
          <div><dt>Plataforma</dt><dd>{data.plataforma}</dd></div>
          {data.serie && (
            <div class="ancho">
              <dt>Serie</dt>
              <dd>{nombreSerie(data.serie)}</dd>
            </div>
          )}
          <div><dt>Sistema</dt><dd>{data.so}</dd></div>
          <div>
            <dt>Fecha</dt>
            <dd><time datetime={data.fecha.toISOString().slice(0, 10)}>{formatearFecha(data.fecha)}</time></dd>
          </div>
        </dl>
      </div>

      <ul class="tecnicas" aria-label="Técnicas">
        {
          data.tecnicas.map((t) => (
            <li>
              <a class="etiqueta" href={`/tecnicas/${slugTecnica(t)}/`}>
                #{t}
              </a>
            </li>
          ))
        }
      </ul>
    </header>

    <div class="cuerpo">
      <nav class="indice" aria-labelledby="titulo-indice">
        <p id="titulo-indice" class="indice-titulo">En esta máquina</p>
        <ol>
          {
            indice.map((h, i) => (
              <li>
                <a href={`#${h.slug}`}>
                  <span class="indice-numero" aria-hidden="true">
                    {numero(i)}
                  </span>
                  {h.text}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      <div class="prosa">
        <Content components={{ Cmd, Pista, Ruta }} />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .franja-borrador {
    margin: 0 0 1.5rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--peligro);
    border-radius: var(--radio);
    background: var(--peligro-bg);
    color: var(--peligro);
    font-family: var(--fuente-mono);
    font-size: 0.9rem;
  }

  .migas {
    margin: 0 0 1rem;
    font-family: var(--fuente-mono);
    font-size: 0.8rem;
    color: var(--texto-suave);
    overflow-wrap: anywhere;
  }

  .migas a {
    text-decoration: none;
  }

  .migas a:hover {
    text-decoration: underline;
  }

  .presentacion {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 1.25rem 2rem;
  }

  .identidad {
    flex: 999 1 24rem;
    min-width: 0;
  }

  .linea-titulo {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .linea-titulo h1 {
    margin: 0;
  }

  .resumen {
    margin: 0.6rem 0 0;
    font-size: 1.05rem;
    color: var(--texto-suave);
    max-width: var(--ancho-lectura);
  }

  .ficha {
    flex: 1 1 17rem;
    min-width: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem 1.25rem;
    margin: 0;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--borde);
    border-radius: var(--radio-lg);
    background: var(--bg-elev);
    font-family: var(--fuente-mono);
  }

  .ficha dt {
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--texto-suave);
  }

  .ficha dd {
    margin: 0.1rem 0 0;
    font-size: 0.85rem;
  }

  /* "Starting Point · Tier 0" no cabe en media columna. */
  .ficha .ancho {
    grid-column: 1 / -1;
  }

  .tecnicas {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  /* ---------- Índice y texto ---------- */
  .cuerpo {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    margin-top: 2.25rem;
  }

  .indice-titulo {
    margin: 0 0 0.75rem;
    font-family: var(--fuente-mono);
    font-size: 0.7rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--texto-suave);
  }

  .indice ol {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--borde);
  }

  .indice a {
    display: flex;
    gap: 0.5rem;
    padding: 0.4rem 0.85rem;
    margin-left: -1px;
    border-left: 2px solid transparent;
    font-family: var(--fuente-mono);
    font-size: 0.82rem;
    color: var(--texto-suave);
    text-decoration: none;
  }

  .indice a:hover {
    border-left-color: var(--acento);
    color: var(--texto);
  }

  /* El número no se mueve, así el título que ocupa dos líneas queda alineado. */
  .indice-numero {
    flex-shrink: 0;
    color: var(--texto-tenue);
  }

  @media (min-width: 64rem) {
    .cuerpo {
      grid-template-columns: 13rem minmax(0, 46rem);
      justify-content: center;
      gap: 3rem;
    }

    .indice {
      position: sticky;
      top: 1.5rem;
      align-self: start;
    }
  }

  .prosa {
    min-width: 0;
    counter-reset: seccion;
  }

  /* Cada sección fija se numera sola: 01 Reconocimiento, 02 Enumeración… */
  .prosa :global(h2) {
    counter-increment: seccion;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin: 2.75rem 0 1.1rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--borde);
    scroll-margin-top: 1rem;
  }

  .prosa :global(h2)::before {
    content: counter(seccion, decimal-leading-zero);
    font-family: var(--fuente-mono);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--acento-texto);
  }

  .prosa > :global(h2:first-child) {
    margin-top: 0;
  }

  .prosa :global(h3) {
    scroll-margin-top: 1rem;
  }

  .prosa :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
  }

  .prosa :global(th),
  .prosa :global(td) {
    border: 1px solid var(--borde);
    padding: 0.4rem 0.6rem;
  }

  .prosa :global(blockquote) {
    margin: 1.25rem 0;
    padding: 0.75rem 1rem;
    border: 1px solid var(--borde);
    border-radius: var(--radio);
    background: var(--bg-elev);
    color: var(--texto-suave);
  }

  .prosa :global(blockquote p) {
    margin: 0;
  }

  /* Las salidas de los comandos: bloque sobrio, con etiqueta. */
  .prosa :global(pre) {
    background: var(--bg-elev);
    font-size: 0.85rem;
    line-height: 1.7;
  }
</style>
