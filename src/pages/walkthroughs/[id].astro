---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Cmd from '../../components/Cmd.astro';
import Pista from '../../components/Pista.astro';
import { obtenerWalkthroughs } from '../../lib/coleccion';
import { comprobarSecciones, formatearFecha, slugTecnica, type Walkthrough } from '../../lib/walkthroughs';

export async function getStaticPaths() {
  const lista = await obtenerWalkthroughs();
  return lista.map((walkthrough) => ({ params: { id: walkthrough.id }, props: { walkthrough } }));
}

interface Props {
  walkthrough: Walkthrough;
}

const { walkthrough } = Astro.props;
const { data } = walkthrough;
const { Content, headings } = await render(walkthrough);
comprobarSecciones(walkthrough.id, headings);

const indice = headings.filter((h) => h.depth === 2);
---

<BaseLayout titulo={data.titulo} descripcion={data.resumen}>
  <article class="walkthrough">
    {
      data.borrador && (
        <p class="franja-borrador" role="note">
          <strong>BORRADOR</strong>: solo se ve en desarrollo y no se publicará.
        </p>
      )
    }

    <header class="cabecera">
      <p class="migas"><a href="/walkthroughs/">walkthroughs</a> / {walkthrough.id}</p>
      <h1>{data.titulo}</h1>
      <p class="resumen">{data.resumen}</p>
      <dl class="ficha">
        <div><dt>Plataforma</dt><dd>{data.plataforma}</dd></div>
        <div><dt>Dificultad</dt><dd>{data.dificultad}</dd></div>
        <div><dt>Sistema</dt><dd>{data.so}</dd></div>
        <div>
          <dt>Fecha</dt>
          <dd><time datetime={data.fecha.toISOString().slice(0, 10)}>{formatearFecha(data.fecha)}</time></dd>
        </div>
        <div class="ficha-tecnicas">
          <dt>Técnicas</dt>
          <dd>
            <ul>
              {data.tecnicas.map((t) => (
                <li><a href={`/tecnicas/${slugTecnica(t)}/`}>#{t}</a></li>
              ))}
            </ul>
          </dd>
        </div>
      </dl>
    </header>

    <div class="cuerpo">
      <nav class="indice" aria-labelledby="titulo-indice">
        <h2 id="titulo-indice" class="indice-titulo">Índice</h2>
        <ol>
          {indice.map((h) => (
            <li><a href={`#${h.slug}`}>{h.text}</a></li>
          ))}
        </ol>
      </nav>

      <div class="prosa">
        <Content components={{ Cmd, Pista }} />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .franja-borrador {
    margin: 0 0 1.5rem;
    padding: 0.75rem 1rem;
    border: 2px solid var(--peligro);
    border-radius: var(--radio);
    color: var(--peligro);
    font-family: var(--fuente-mono);
  }

  .migas {
    margin: 0 0 0.5rem;
    font-family: var(--fuente-mono);
    font-size: 0.85rem;
    color: var(--texto-suave);
    overflow-wrap: anywhere;
  }

  .resumen {
    font-size: 1.1rem;
    color: var(--texto-suave);
    max-width: var(--ancho-lectura);
  }

  .ficha {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.75rem;
    margin: 1.25rem 0 0;
    padding: 1rem 0;
    border-block: 1px solid var(--borde);
    font-family: var(--fuente-mono);
    font-size: 0.9rem;
  }

  .ficha dt {
    font-size: 0.75rem;
    color: var(--texto-suave);
  }

  .ficha dd {
    margin: 0;
  }

  .ficha ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.75rem;
  }

  .cuerpo {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem 3rem;
    margin-top: 1.5rem;
  }

  .indice {
    font-family: var(--fuente-mono);
    font-size: 0.9rem;
  }

  .indice-titulo {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--texto-suave);
    margin: 0 0 0.5rem;
  }

  .indice ol {
    margin: 0;
    padding-left: 1.5rem;
  }

  .indice a {
    display: inline-block;
    padding: 0.15rem 0;
  }

  @media (min-width: 64rem) {
    .cuerpo {
      grid-template-columns: minmax(0, var(--ancho-lectura)) 14rem;
    }

    .indice {
      order: 2;
      position: sticky;
      top: 1.5rem;
      align-self: start;
    }
  }

  .prosa {
    min-width: 0;
  }

  .prosa :global(h2) {
    padding-top: 1rem;
    border-top: 1px solid var(--borde);
    scroll-margin-top: 1rem;
  }

  .prosa :global(h2)::before {
    content: '## ';
    color: var(--acento-texto);
  }

  .prosa :global(h3) {
    scroll-margin-top: 1rem;
  }

  .prosa > :global(h2:first-child) {
    margin-top: 0;
  }

  .prosa :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
  }

  .prosa :global(th),
  .prosa :global(td) {
    border: 1px solid var(--borde);
    padding: 0.4rem 0.6rem;
  }

  .prosa :global(blockquote) {
    margin: 1rem 0;
    padding: 0.25rem 1rem;
    border-left: 3px solid var(--acento);
    color: var(--texto-suave);
  }
</style>
